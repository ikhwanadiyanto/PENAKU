        function prosesDataRegistryAlumniDariSheet(dataArray) {
            if (!Array.isArray(dataArray)) return;
            let registryMap = {};
            listAlumniTerdaftar.forEach(a => {
                registryMap[a.id] = { ...a, status: normalizeAlumniStatus(a), _ts: a.updatedAt || 0 };
            });

            let hasRegistryUpdates = false;
            const newlyDetectedPending = [];

            dataArray.forEach(row => {
                if (String(row.grup || "") === "SIXBOOK_ALUMNI_REGISTRY" && row.pesan) {
                    try {
                        const parsed = typeof row.pesan === 'string' ? JSON.parse(row.pesan) : row.pesan;
                        if (parsed && parsed.id && parsed.username) {
                            const rowTs = parseInt(parsed.updatedAt) || (parseInt(String(row.id || "0").replace(/[^\d]/g, '')) || 0);
                            const existing = registryMap[parsed.id];
                            if (!existing || rowTs >= (existing._ts || 0)) {
                                const normStatus = normalizeAlumniStatus(parsed);
                                registryMap[parsed.id] = {
                                    id: parsed.id,
                                    username: parsed.username,
                                    nama: parsed.nama || parsed.username,
                                    angkatan: parsed.angkatan || "2025",
                                    password: parsed.password || "",
                                    fotoProfil: parsed.fotoProfil || (existing && existing.fotoProfil) || "",
                                    status: normStatus,
                                    sourceSiswaNis: parsed.sourceSiswaNis || (existing && existing.sourceSiswaNis) || "",
                                    createdAt: parsed.createdAt || (existing && existing.createdAt) || "",
                                    updatedAt: rowTs,
                                    _ts: rowTs
                                };
                                hasRegistryUpdates = true;

                                if (normStatus === "pending" && !knownPendingAlumniIds.has(parsed.id)) {
                                    knownPendingAlumniIds.add(parsed.id);
                                    newlyDetectedPending.push(registryMap[parsed.id]);
                                }
                            }
                        }
                    } catch (e) {}
                }
            });

            if (hasRegistryUpdates) {
                listAlumniTerdaftar = Object.values(registryMap)
                    .filter(a => normalizeAlumniStatus(a) !== "rejected")
                    .map(({ _ts, ...rest }) => rest);

                simpanDaftarAlumniSemuaStorage();
                perbaruiBadgeAntrianAlumniUI();

                if (isAdminMode && newlyDetectedPending.length > 0 && loggedInNis) {
                    const lastP = newlyDetectedPending[newlyDetectedPending.length - 1];
                    playBeepSound(1080, 'sine', 0.16);
                    setTimeout(() => playBeepSound(1320, 'sine', 0.18), 140);
                    tampilToastCeria(`Ada pendaftar Alumni baru menunggu persetujuan: ${lastP.nama} (@${lastP.username})! 🎓`, "warning", "⏳");
                }

                if (loggedInNis) {
                    populasiDropdownSiswa();
                    const isDaftarTabOpen = !document.getElementById('frameSectionDaftarSiswa')?.classList.contains('hidden');
                    if (isDaftarTabOpen) {
                        renderGridAntrianApprovalAlumni();
                        renderGridDaftarAlumni();
                    }
                }
            }
        }

