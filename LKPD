                    const isMentioned = cekApakahPostMenyebutUser(p, targetFriendNis);
                    const isRepostedByTarget = Array.isArray(p.reposts) && p.reposts.includes(targetFriendNis);
                    return isAuthor || isMentioned || isRepostedByTarget;
                });
            }

            if (activeFeedFilter === 'mine') {
                activePosts = activePosts.filter(p => (String(p.nis) === myNis) || (isAdminMode && (p.nis === 'admin' || p.nis === ADMIN_NIS)));
            } else if (activeFeedFilter === 'mentions') {
                activePosts = activePosts.filter(p => cekApakahPostMenyebutUser(p, myNis));
            }

            if (activeKeywordFilter && activeKeywordFilter.length > 0) {
                const kw = activeKeywordFilter;
                activePosts = activePosts.filter(p => {
                    const info = getUserDisplayInfo(p.nis);
                    const teksMatch = (p.teks || '').toLowerCase().includes(kw);
                    const quizMatch = p.quiz && (
                        (p.quiz.question || '').toLowerCase().includes(kw) ||
                        Object.values(p.quiz.options || {}).some(opt => String(opt).toLowerCase().includes(kw))
                    );
                    const penulisMatch = (info.nama || '').toLowerCase().includes(kw) || (p.nama || '').toLowerCase().includes(kw);
                    const komenMatch = (p.comments || []).some(c => !c.isDeleted && ((c.teks || '').toLowerCase().includes(kw) || (c.nama || '').toLowerCase().includes(kw)));
                    return teksMatch || quizMatch || penulisMatch || komenMatch;
                });
            }

            if (activePosts.length === 0) {
                let emptyMsg = "Belum ada status di linimasa. Jadilah yang pertama berbagi cerita ceria hari ini! 🎃👻";
                if (activeKeywordFilter) emptyMsg = `Tidak ada postingan yang cocok dengan kata kunci "${escapeHtmlSafe(activeKeywordFilter)}" 👻`;
                else if (activeFriendFeedNis) emptyMsg = "Teman ini belum memiliki postingan atau sebutan (@) di linimasa 👻";
                else if (activeFeedFilter === 'mine') emptyMsg = "Kamu belum memiliki postingan status. Yuk tulis status pertamamu! 🎃";
                else if (activeFeedFilter === 'mentions') emptyMsg = "Belum ada postingan yang menyebut (@) namamu. Coba sebut temanmu! 🔔";
                container.innerHTML = `<div class="text-center text-xs text-slate-600 italic py-8 bg-white/95 rounded-3xl border-2 border-orange-300 shadow-sm">${emptyMsg}</div>`;
                return;
            }

            const totalActive = activePosts.length;
            const visibleLimit = currentPageFeed * FEEDS_PER_PAGE;
            const postsToRender = activePosts.slice(0, visibleLimit);

            let htmlFeeds = postsToRender.map(post => {
                const isPostAdmin = (post.nis === 'admin' || post.nis === ADMIN_NIS || post.nama.includes('Ikhwan') || post.nama.includes('💎'));
                const isPostAlumni = isAlumniId(post.nis);
                const info = getUserDisplayInfo(post.nis);
                const pData = isPostAdmin ? (dbProfilDetail['admin'] || {}) : (dbProfilDetail[post.nis] || {});

                let levelBadgeHtml = "";
                let badgePamerHtml = "";

                if (isPostAdmin) {
                    levelBadgeHtml = `<span class="admin-glow-badge text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase">ADMIN</span>`;
                } else if (isPostAlumni) {
                    levelBadgeHtml = `<span class="alumni-glow-badge text-white text-[9px] font-black px-2 py-0.5 rounded-full uppercase">ALUMNI ${escapeHtmlSafe(info.angkatan)}</span>`;
                } else {
                    const lvlInfo = hitungLevelAkademik(pData.nilai || {});
                    levelBadgeHtml = `<span class="text-[9px] font-black px-2 py-0.5 rounded-full bg-purple-700 text-white">Level ${lvlInfo.level}</span>`;

                    if (pData.pamerBadgeIdx !== undefined && pData.pamerBadgeIdx !== null) {
                        const bIdx = parseInt(pData.pamerBadgeIdx);
                        const bObj = (pData.badges && pData.badges[bIdx]) ? pData.badges[bIdx] : null;
                        if (bObj && bObj.active) {
                            const iconHtml = bObj.img ? `<img src="${bObj.img}" class="w-4 h-4 rounded-sm object-cover inline">` : `⭐`;
                            badgePamerHtml = `<span class="inline-flex items-center gap-1 bg-orange-100 border border-orange-300 text-orange-950 text-[9px] font-extrabold px-2 py-0.5 rounded-full">${iconHtml} ${bObj.title || BADGE_DESCS[bIdx]}</span>`;
                        }
                    }
                }

                const likes = Array.isArray(post.likes) ? post.likes : [];
                const isLikedByMe = likes.includes(myNis);
                const reposts = Array.isArray(post.reposts) ? post.reposts : [];
                const isRepostedByMe = reposts.includes(myNis);
                const comments = Array.isArray(post.comments) ? post.comments.filter(c => !c.isDeleted) : [];
                const canDeletePost = isAdminMode || (post.nis === myNis);

                const isTopRankAuthor = (!isPostAdmin && !isPostAlumni && topJuaraNis && String(post.nis) === topJuaraNis);
                const authorTargetNis = isPostAdmin ? ADMIN_NIS : String(post.nis);

                let ytEmbedHtml = "";
                const ytId = extractYouTubeId(post.youtubeUrl);
                if (ytId) {
                    ytEmbedHtml = `
                        <div class="embed-youtube-container mt-2 mb-2.5" onpointerenter="aktifkanJedaModeVideoYoutube(35000)">
                            <iframe src="https://www.youtube.com/embed/${ytId}?rel=0" title="YouTube video player" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen loading="lazy"></iframe>
                        </div>
                    `;
                }

                // RENDER BLOK KUIS ABCD JIKA POSTINGAN MEMILIKI KUIS
                let quizBlockHtml = "";
                if (post.quiz && post.quiz.question && post.quiz.options) {
                    const qObj = post.quiz;
                    const responses = (qObj.responses && typeof qObj.responses === 'object') ? qObj.responses : {};
                    const myResp = responses[myNis] || null;
                    const kunciBenar = String(qObj.answerKey || "A").toUpperCase();
                    const totalPenjawab = Object.keys(responses).length;
                    const totalBenar = Object.values(responses).filter(r => r && r.isCorrect).length;
                    const animType = recentQuizAnimState[post.id] || "";
                    const animClass = animType === "correct" ? "quiz-correct-anim" : (animType === "wrong" ? "quiz-wrong-anim" : "");

                    const pilihanHurufList = ['A', 'B', 'C', 'D'];
                    const pilihanButtonsHtml = pilihanHurufList.map(huruf => {
                        const teksOpsi = qObj.options[huruf] || "";
                        const isSelectedByMe = myResp && String(myResp.choice).toUpperCase() === huruf;
                        const isThisKey = (huruf === kunciBenar);

                        let btnStyle = "bg-white hover:bg-purple-50 text-slate-900 border-2 border-purple-200 hover:border-purple-500";
                        let badgeStyle = "bg-purple-700 text-white";
                        let statusIcon = "";

                        if (myResp) {
                            if (isThisKey) {
                                btnStyle = "bg-emerald-50 text-emerald-950 border-2 border-emerald-500 shadow-sm";
                                badgeStyle = "bg-emerald-600 text-white";
                                statusIcon = `<span class="text-xs font-black text-emerald-700 shrink-0 flex items-center gap-1"><i class="fa-solid fa-circle-check"></i> Benar!</span>`;
                            } else if (isSelectedByMe && !myResp.isCorrect) {
                                btnStyle = "bg-rose-50 text-rose-950 border-2 border-rose-500";
                                badgeStyle = "bg-rose-600 text-white";
                                statusIcon = `<span class="text-xs font-black text-rose-700 shrink-0 flex items-center gap-1"><i class="fa-solid fa-circle-xmark"></i> Pilihanmu</span>`;
                            } else {
                                btnStyle = "bg-slate-50 text-slate-500 border border-slate-200 opacity-75";
                                badgeStyle = "bg-slate-400 text-white";
                            }
                        } else if (isAdminMode && isThisKey) {
                            btnStyle = "bg-emerald-50/70 hover:bg-emerald-100 text-slate-900 border-2 border-emerald-400";
                            badgeStyle = "bg-emerald-600 text-white";
                            statusIcon = `<span class="text-[10px] font-black text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded-full shrink-0">Kunci ✓</span>`;
                        }

                        return `
                            <button type="button" onclick="jawabKuisPost('${post.id}', '${huruf}')" ${myResp && !isAdminMode ? 'disabled' : ''} class="w-full p-2.5 rounded-xl text-left flex items-center justify-between gap-2.5 transition-all active:scale-98 ${btnStyle} ${myResp && !isAdminMode ? 'cursor-default' : 'cursor-pointer'}">
                                <div class="flex items-center gap-2.5 min-w-0">
                                    <span class="w-7 h-7 rounded-lg ${badgeStyle} font-cute font-black text-xs flex items-center justify-center shrink-0 shadow-xs">${huruf}</span>
                                    <span class="text-xs font-bold break-words">${escapeHtmlSafe(teksOpsi)}</span>
                                </div>
                                ${statusIcon}
                            </button>
                        `;
                    }).join('');

                    let hasilBannerHtml = "";
                    if (myResp) {
                        if (myResp.isCorrect) {
                            hasilBannerHtml = `
                                <div class="mt-2.5 p-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-xs font-cute font-black flex items-center justify-between gap-2 shadow-sm">
                                    <span>🎉 Luar Biasa! Jawabanmu (${myResp.choice}) BENAR!</span>
                                    <span class="text-[10px] bg-white/25 px-2 py-0.5 rounded-full">+100% Semangat!</span>
                                </div>
                            `;
                        } else {
                            hasilBannerHtml = `
                                <div class="mt-2.5 p-2.5 rounded-xl bg-gradient-to-r from-rose-600 to-orange-600 text-white text-xs font-cute font-black flex items-center justify-between gap-2 shadow-sm">
                                    <span>💥 Yah, jawaban (${myResp.choice}) kurang tepat! Kunci: ${kunciBenar}</span>
                                    <span class="text-[10px] bg-white/25 px-2 py-0.5 rounded-full">Tetap Semangat!</span>
                                </div>
                            `;
                        }
                    }

                    quizBlockHtml = `
                        <div class="mt-2.5 mb-2.5 p-3.5 sm:p-4 rounded-2xl bg-gradient-to-br from-indigo-50 via-purple-50 to-amber-50 border-2 border-indigo-300 shadow-sm ${animClass}">
                            <div class="flex items-center justify-between gap-2 mb-2 flex-wrap">
                                <span class="inline-flex items-center gap-1.5 text-[10px] font-black uppercase tracking-wider bg-indigo-600 text-white px-2.5 py-0.5 rounded-full shadow-2xs">
                                    <i class="fa-solid fa-circle-question"></i> Kuis Interaktif Kelas 6
                                </span>
                                <span class="text-[10px] font-bold text-indigo-900 bg-white/90 px-2.5 py-0.5 rounded-full border border-indigo-200">
                                    👥 ${totalPenjawab} Menjawab • ✅ ${totalBenar} Benar
                                </span>
                            </div>
                            <p class="text-xs sm:text-sm font-black text-slate-900 mb-3 leading-snug break-words">${escapeHtmlSafe(qObj.question)}</p>
                            <div class="space-y-2">
                                ${pilihanButtonsHtml}
                            </div>
                            ${hasilBannerHtml}
                        </div>
                    `;
                }

                const commentsHtml = comments.map(c => {
                    const isCommentAdmin = (c.nis === 'admin' || c.nis === ADMIN_NIS || c.nama.includes('Ikhwan') || c.nama.includes('💎'));
                    const isCommentAlumni = isAlumniId(c.nis);
                    const cInfo = getUserDisplayInfo(c.nis);
                    const canDeleteComment = isAdminMode || (c.nis === myNis) || (post.nis === myNis);
                    const isTopRankCommenter = (!isCommentAdmin && !isCommentAlumni && topJuaraNis && String(c.nis) === topJuaraNis);
                    const cAuthorNis = isCommentAdmin ? ADMIN_NIS : String(c.nis);

                    return `
                        <div id="comment_bubble_${c.id}" class="flex items-start gap-2 pt-2 transition-all">
                            <div class="relative shrink-0 w-8 h-8 flex items-center justify-center cursor-pointer" onclick="bukaFeedTeman('${cAuthorNis}')">
                                <img src="${cInfo.foto}" class="w-7 h-7 rounded-full object-cover border border-purple-300">
                                ${isTopRankCommenter ? `<span class="absolute -top-1.5 -right-1 text-[10px]">👑</span>` : ''}
                            </div>
                            <div class="feed-chat-bubble-reply px-3 py-2 flex-1 min-w-0">
                                <div class="flex items-center justify-between gap-2">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <span onclick="bukaFeedTeman('${cAuthorNis}')" class="text-[11px] font-bold text-slate-900 hover:text-purple-700 cursor-pointer">${escapeHtmlSafe(cInfo.nama)}</span>
                                        ${isCommentAdmin ? `<span class="bg-purple-700 text-white text-[8px] font-black px-1.5 py-0.2 rounded uppercase">ADMIN</span>` : ''}
                                        ${isCommentAlumni ? `<span class="bg-teal-600 text-white text-[8px] font-black px-1.5 py-0.2 rounded uppercase">ALUMNI</span>` : ''}
                                        <span class="text-[9px] text-slate-500">${c.waktu || ''}</span>
                                    </div>
                                    ${canDeleteComment ? `
                                        <button onclick="hapusKomentarStatus('${post.id}', '${c.id}')" class="text-[10px] text-slate-400 hover:text-rose-600 transition-colors" title="Hapus Komentar">
                                            <i class="fa-solid fa-trash-can"></i>
                                        </button>
                                    ` : ''}
                                </div>
                                <p class="text-xs text-slate-800 mt-0.5 leading-snug break-words">${formatTeksDenganMentionTwitter(c.teks)}</p>
                            </div>
                        </div>
                    `;
                }).join('');

                return `
                    <div id="feed_post_${post.id}" class="feed-chat-bubble p-4 sm:p-5 transition-all">
                        <div class="flex items-start justify-between gap-3 mb-2.5">
                            <div class="flex items-center gap-3 min-w-0">
                                <div class="relative shrink-0 w-12 h-12 flex items-center justify-center cursor-pointer" onclick="bukaFeedTeman('${authorTargetNis}')">
                                    <img src="${info.foto}" class="w-11 h-11 rounded-full object-cover border-2 ${isTopRankAuthor ? 'border-amber-400 shadow-sm' : 'border-orange-400'}">
                                    ${isTopRankAuthor ? `
                                    <div class="absolute -top-2 -right-1 z-10 logo-emoji-anim" title="Juara 1 Nilai Rata-Rata Tertinggi!">
                                        <span class="text-sm">👑</span>
                                    </div>` : ''}
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <h4 onclick="bukaFeedTeman('${authorTargetNis}')" class="text-xs sm:text-sm font-bold text-slate-900 hover:text-purple-700 cursor-pointer truncate">${escapeHtmlSafe(info.nama)}</h4>
                                        <span onclick="bukaFeedTeman('${authorTargetNis}')" class="text-[10px] font-bold text-purple-700 hover:underline cursor-pointer">${info.handle}</span>
                                        ${levelBadgeHtml}
                                        ${badgePamerHtml}
                                    </div>
                                    <span class="text-[10px] text-slate-500 font-medium flex items-center gap-1 mt-0.5">
                                        <i class="fa-regular fa-clock"></i> ${post.waktu}
                                    </span>
                                </div>
                            </div>

                            ${canDeletePost ? `
                                <button onclick="hapusStatusFeed('${post.id}')" class="text-slate-400 hover:text-rose-600 p-1.5 rounded-lg hover:bg-rose-50 transition-all text-xs shrink-0" title="Hapus Status">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>
                            ` : ''}
                        </div>

                        ${post.teks ? `<p class="text-xs sm:text-sm text-slate-800 leading-relaxed mb-2.5 whitespace-pre-wrap break-words">${formatTeksDenganMentionTwitter(post.teks)}</p>` : ''}
                        ${quizBlockHtml}
                        ${ytEmbedHtml}
                        ${post.foto ? `
                            <div class="rounded-2xl overflow-hidden border border-slate-200 mb-3 bg-slate-50 flex justify-center">
                                <img src="${post.foto}" onclick="lihatFotoChatZoom(this.src)" class="max-h-80 w-auto object-contain cursor-pointer hover:opacity-95 transition-all">
                            </div>
                        ` : ''}

                        <div class="flex items-center gap-4 pt-2 border-t border-slate-100 text-xs font-bold flex-wrap">
                            <button id="btn_like_${post.id}" onclick="toggleLikeStatus('${post.id}')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl transition-all ${isLikedByMe ? 'bg-rose-100 text-rose-700' : 'text-slate-600 hover:bg-slate-100'}">
                                <i class="${isLikedByMe ? 'fa-solid fa-heart text-rose-600' : 'fa-regular fa-heart'} text-sm"></i>
                                <span>${likes.length}</span> Suka
                            </button>

                            <button id="btn_repost_${post.id}" onclick="toggleRepostStatus('${post.id}')" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl transition-all ${isRepostedByMe ? 'bg-emerald-100 text-emerald-800' : 'text-slate-600 hover:bg-slate-100'}" title="Posting Ulang ke Berandamu">
                                <i class="fa-solid fa-retweet ${isRepostedByMe ? 'text-emerald-600' : ''} text-sm"></i>
                                <span>${reposts.length}</span> Repost
                            </button>

                            <button onclick="document.getElementById('inputKomen_${post.id}').focus()" class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-slate-600 hover:bg-slate-100 transition-all">
                                <i class="fa-regular fa-comment-dots text-purple-600 text-sm"></i>
                                <span>${comments.length}</span> Komentar
                            </button>
                        </div>

                        <div class="mt-2.5 pt-2 border-t border-slate-100/80 space-y-2">
                            ${commentsHtml}
                            <div class="flex items-center gap-2 pt-2">
                                <button type="button" onclick="toggleMentionPicker(event, 'inputKomen_${post.id}')" class="w-8 h-8 rounded-full bg-purple-100 hover:bg-orange-200 text-purple-800 font-black text-xs flex items-center justify-center shrink-0 transition-all" title="Sebut Teman (@)">@</button>
                                <input type="text" id="inputKomen_${post.id}" onkeyup="deteksiAutocompleteMention(event, 'inputKomen_${post.id}')" onkeypress="if(event.key==='Enter') kirimKomentarStatus('${post.id}')" placeholder="Tulis komentar & @teman..." class="flex-1 min-w-0 bg-orange-50/70 text-slate-900 text-xs border border-orange-200 rounded-full px-3.5 py-2 focus:outline-none focus:border-purple-500">
                                <button onclick="kirimKomentarStatus('${post.id}')" class="bg-purple-700 hover:bg-purple-800 text-white rounded-full w-8 h-8 flex items-center justify-center text-xs shadow-sm transition-all active:scale-90 shrink-0">
                                    <i class="fa-solid fa-paper-plane"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');

            if (totalActive > visibleLimit) {
                const sisa = totalActive - visibleLimit;
                htmlFeeds += `
                    <div class="text-center pt-2 pb-4 no-print">
                        <button onclick="muatLebihBanyakFeed()" class="w-full sm:w-auto px-6 py-3 rounded-2xl bg-white hover:bg-orange-50 text-purple-900 font-cute font-black text-xs border-2 border-orange-300 shadow-md transition-all active:scale-95 flex items-center justify-center gap-2 mx-auto">
                            <i class="fa-solid fa-angles-down text-orange-600"></i> Muat Lebih Banyak (${sisa} Status Lagi) 🎃
                        </button>
                    </div>
                `;
            }

            container.innerHTML = htmlFeeds;
        }

        function toggleLikeStatus(postId) {
            const post = listFeedsPost.find(p => p.id === postId);
            if (!post) return;
            const myNis = isAdminMode ? ADMIN_NIS : String(loggedInNis);
            if (!Array.isArray(post.likes)) post.likes = [];

            const idx = post.likes.indexOf(myNis);
            if (idx === -1) {
                post.likes.push(myNis);
                playBeepSound(1050, 'sine', 0.1);
            } else {
                post.likes.splice(idx, 1);
                playBeepSound(600, 'sine', 0.08);
            }

            simpanFeedsKeIndexedDB(listFeedsPost);
            renderFeedsStatusUI();
            kirimSingleFeedPostKeSheet(post);
        }

        function toggleRepostStatus(postId) {
            const post = listFeedsPost.find(p => p.id === postId);
            if (!post) return;
            const myNis = isAdminMode ? ADMIN_NIS : String(loggedInNis);
            if (!Array.isArray(post.reposts)) post.reposts = [];

            const idx = post.reposts.indexOf(myNis);
            if (idx === -1) {
                post.reposts.push(myNis);
                playBeepSound(1120, 'sine', 0.12);
                tampilToastCeria("Berhasil memposting ulang status ke berandamu! 🔁🎃", "success", "🔁");
            } else {
                post.reposts.splice(idx, 1);
                playBeepSound(650, 'sine', 0.08);
                tampilToastCeria("Repost dibatalkan.", "info", "↩️");
            }

            simpanFeedsKeIndexedDB(listFeedsPost);
            renderFeedsStatusUI();
            kirimSingleFeedPostKeSheet(post);
        }

        function kirimKomentarStatus(postId) {
            const inputEl = document.getElementById(`inputKomen_${postId}`);
            const teks = inputEl ? inputEl.value.trim() : "";
            if (!teks) return;

            const post = listFeedsPost.find(p => p.id === postId);
            if (!post) return;

            const info = getUserDisplayInfo(loggedInNis);
            const now = new Date();
            const waktuStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

            if (!Array.isArray(post.comments)) post.comments = [];
            const newComment = {
                id: "comment_" + Date.now(),
                postId: postId,
                nis: isAdminMode ? ADMIN_NIS : String(loggedInNis),
                nama: info.nama,
                teks: teks,
                waktu: waktuStr,
                isDeleted: false
            };

            post.comments.push(newComment);
            inputEl.value = "";
            playBeepSound(880, 'sine', 0.1);

            simpanFeedsKeIndexedDB(listFeedsPost);
            perbaruiBannerBerandaFeed();
            updateBadgeJumlahSebutan();
            renderFeedsStatusUI();
            kirimSingleFeedPostKeSheet(post);
        }

        async function hapusStatusFeed(postId) {
            const setuju = await tampilKonfirmasiCeria("Hapus status ini secara permanen dari linimasa SIXBOOK?", "Hapus Postingan", "🗑️");
            if (!setuju) return;

            const postEl = document.getElementById(`feed_post_${postId}`);
            if (postEl) postEl.classList.add('waving-goodbye-anim');
            playBeepSound(400, 'sawtooth', 0.15);

            setTimeout(async () => {
                const post = listFeedsPost.find(p => p.id === postId);
                if (post) {
                    post.isDeleted = true;
                    lastKnownFeedCount = listFeedsPost.filter(p => !p.isDeleted).length;
                    await simpanFeedsKeIndexedDB(listFeedsPost);
                    perbaruiBannerBerandaFeed();
                    updateBadgeJumlahSebutan();
                    renderFeedsStatusUI();
                    tampilToastCeria("Status berhasil dihapus dari linimasa.", "info", "🗑️");
                    kirimSingleFeedPostKeSheet(post);
                }
            }, 800);
        }

        async function hapusKomentarStatus(postId, commentId) {
            const setuju = await tampilKonfirmasiCeria("Hapus komentar ini dari postingan?", "Hapus Komentar", "💬");
            if (!setuju) return;

            const commentEl = document.getElementById(`comment_bubble_${commentId}`);
            if (commentEl) commentEl.classList.add('waving-goodbye-anim');
            playBeepSound(450, 'sawtooth', 0.12);

            setTimeout(async () => {
                const post = listFeedsPost.find(p => p.id === postId);
                if (post && Array.isArray(post.comments)) {
                    const comment = post.comments.find(c => c.id === commentId);
                    if (comment) {
                        comment.isDeleted = true;
                        await simpanFeedsKeIndexedDB(listFeedsPost);
                        perbaruiBannerBerandaFeed();
                        updateBadgeJumlahSebutan();
                        renderFeedsStatusUI();
