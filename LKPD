        function renderBadgesSiswa() {
            const pData = dbProfilDetail[currentNis];
            if (!pData || currentNis === 'admin') return;
            const grid = document.getElementById('grid10Badges');
            if (!pData.badges || pData.badges.length < 25) {
                pData.badges = Array(25).fill().map((_, i) => ({ active: false, img: "", title: BADGE_DESCS[i] }));
            }

            const totalTerbuka = pData.badges.filter(b => b.active).length;
            document.getElementById('lblBadgeCounter').innerText = `${totalTerbuka} / 25 Terbuka`;
            document.getElementById('barBadgeProgress').style.width = `${(totalTerbuka / 25) * 100}%`;

            const limitCount = showAll25Badges ? 25 : 10;
            let html = "";
            for (let i = 0; i < limitCount; i++) {
                const badge = pData.badges[i] || { active: false, img: "", title: BADGE_DESCS[i] };
