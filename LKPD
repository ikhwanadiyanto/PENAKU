            const nilaiObj = pData.nilai || {};
            const grid = document.getElementById('gridMapelInputs');
            const badgeStatus = document.getElementById('lblBadgeStatusMapel');
            const infoText = document.getElementById('lblMapelInfoText');

            if (isAdminMode) {
                badgeStatus.innerHTML = `<i class="fa-solid fa-pen-to-square"></i> Mode Edit Admin`;
                badgeStatus.className = "inline-flex text-[10px] font-bold text-purple-900 bg-purple-100 border border-purple-300 px-2.5 py-1 rounded-full items-center gap-1";
                infoText.innerText = "Nilai Akademik (Mode Edit Aktif - Otomatis Tersinkronisasi)";
            } else {
                badgeStatus.innerHTML = `<i class="fa-solid fa-lock"></i> Mode Baca Sahaja`;
                badgeStatus.className = "inline-flex text-[10px] font-bold text-amber-900 bg-amber-100 border border-amber-300 px-2.5 py-1 rounded-full items-center gap-1";
                infoText.innerText = "Nilai Akademik (Terkunci - Read Only dari Sheet)";
