        function formatTeksDenganMentionTwitter(teksRaw) {
            const safe = escapeHtmlSafe(teksRaw || '');
            const daftar = getDaftarTemanMention().sort((a, b) => b.nama.length - a.nama.length);
            let result = safe;

            daftar.forEach(item => {
                const namaEsc = escapeHtmlSafe(item.nama).replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const handleEsc = item.handle.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
                const regexNama = new RegExp(`@${namaEsc}(?![a-zA-Z0-9_])`, 'gi');
                result = result.replace(regexNama, `<span onclick="bukaFeedTeman('${item.nis}')" class="mention-tag-twitter" title="Klik untuk buka beranda ${escapeHtmlSafe(item.nama)}">@${escapeHtmlSafe(item.nama)}</span>`);

                const regexHandle = new RegExp(`${handleEsc}(?![a-zA-Z0-9_])`, 'gi');
                result = result.replace(regexHandle, `<span onclick="bukaFeedTeman('${item.nis}')" class="mention-tag-twitter" title="Klik untuk buka beranda ${escapeHtmlSafe(item.nama)}">${item.handle}</span>`);
            });
            return result;
        }

        function cekApakahPostMenyebutUser(postObj, targetNis) {
            if (!postObj || !targetNis) return false;
            const myNis = (targetNis === 'admin') ? ADMIN_NIS : String(targetNis);
            const info = getUserDisplayInfo(myNis);
            const targetNama = info.nama;
            const targetHandle = info.handle;
            const firstName = targetNama.replace(/[^\w\s]/g, '').trim().split(/\s+/)[0] || '';

            const gabungTeks = [
                postObj.teks || '',
                ...(postObj.comments || []).filter(c => !c.isDeleted).map(c => c.teks || '')
            ].join(' ').toLowerCase();

            if (!gabungTeks.includes('@')) return false;
            if (targetNama && gabungTeks.includes('@' + targetNama.toLowerCase())) return true;
            if (targetHandle && gabungTeks.includes(targetHandle.toLowerCase())) return true;
            if (firstName && firstName.length >= 3) {
                const rx = new RegExp(`@${firstName.toLowerCase()}(?![a-z0-9_])`, 'i');
                if (rx.test(gabungTeks)) return true;
            }
            return false;
        }

