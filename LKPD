        function prosesDataChatAdminDariSheet(dataArray) {
            if (!Array.isArray(dataArray)) return;
            let hasNewDM = false;
            const newlyArrivedIncoming = [];
            const myNis = isAdminMode ? ADMIN_NIS : String(loggedInNis || "");
            const isChatTabOpen = !document.getElementById('frameSectionChatAdmin')?.classList.contains('hidden');

            dataArray.forEach(row => {
                if (String(row.grup || "") === "SIXBOOK_DM_ADMIN" && row.pesan) {
                    try {
                        const parsed = typeof row.pesan === 'string' ? JSON.parse(row.pesan) : row.pesan;
                        if (parsed && parsed.id && parsed.siswaNis) {
                            const sNis = String(parsed.siswaNis);
                            if (!dbChatAdmin[sNis]) dbChatAdmin[sNis] = [];
                            if (!dbChatAdmin[sNis].some(x => x.id === parsed.id)) {
                                if (parsed.foto) parsed.foto = normalizePhotoUrlFromSheet(parsed.foto);
                                dbChatAdmin[sNis].push(parsed);
                                hasNewDM = true;

                                const isRelevantToMe = isAdminMode || (sNis === myNis);
                                const isFromOther = isAdminMode
                                    ? (parsed.role !== 'Admin' && String(parsed.senderNis) !== ADMIN_NIS && String(parsed.senderNis) !== 'admin')
                                    : (String(parsed.senderNis) !== myNis);

                                if (isRelevantToMe && isFromOther && !seenChatAdminMsgIds.has(String(parsed.id))) {
                                    const sedangMembukaRoomIni = isChatTabOpen && (!isAdminMode || String(selectedChatAdminSiswaNis) === sNis);
                                    if (sedangMembukaRoomIni) {
                                        seenChatAdminMsgIds.add(String(parsed.id));
                                    } else {
                                        unreadChatAdminBySiswa[sNis] = (parseInt(unreadChatAdminBySiswa[sNis]) || 0) + 1;
                                        newlyArrivedIncoming.push(parsed);
                                    }
                                } else {
                                    seenChatAdminMsgIds.add(String(parsed.id));
                                }
                            }
                        }
                    } catch (e) {}
                }
            });

            if (hasNewDM) {
                Object.keys(dbChatAdmin).forEach(k => {
                    dbChatAdmin[k].sort((a, b) => (parseInt(String(a.id).replace(/[^\d]/g, '')) || 0) - (parseInt(String(b.id).replace(/[^\d]/g, '')) || 0));
                });
                simpanSeenChatAdminIds();
                simpanChatAdminKeIndexedDB(dbChatAdmin);
                try { localStorage.setItem("sixbook_chat_admin_v4", JSON.stringify(dbChatAdmin)); } catch (e) {}

                perbaruiBadgeUnreadChatAdminUI();

                if (newlyArrivedIncoming.length > 0 && loggedInNis) {
                    const lastIncoming = newlyArrivedIncoming[newlyArrivedIncoming.length - 1];
                    triggerPopUpNotifChatAdmin(lastIncoming);
                }

                if (isChatTabOpen) {
                    const targetNis = isAdminMode ? selectedChatAdminSiswaNis : String(loggedInNis);
                    renderGelembungChatAdmin(targetNis);
                    if (isAdminMode) renderDaftarSiswaChatAdmin(document.getElementById('inputCariChatSiswaAdmin')?.value || "");
                }
            }
        }

