                const isImg = Boolean(badge.img);
                html += `
                    <div class="badge-item-box ${badge.active ? 'active' : ''}" onclick="toggleBadgeStatus(${i})" title="${badge.active ? 'Terbuka' : 'Terkunci'}">
                        ${isAdminMode ? `
