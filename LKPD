        async function kirimSingleFeedPostKeSheet(postObj) {
            if (!DEFAULT_SCRIPT_URL) return;
            setStatusSyncCloud('syncing', 'Mengirim Status...');
            try {
                await fetch(DEFAULT_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: "sendChatMessage",
                        nis: postObj.nis,
                        nama: postObj.nama,
                        grup: "SIXBOOK_FEED",
                        pesan: JSON.stringify(postObj),
                        role: (postObj.nis === ADMIN_NIS || postObj.nis === 'admin') ? "Admin" : (isAlumniId(postObj.nis) ? "Alumni" : "Siswa")
                    })
                });
                setStatusSyncCloud('synced', 'Tersinkron Cloud');
            } catch (e) {
                setStatusSyncCloud('offline', 'Tersimpan Lokal');
            }
        }

        async function kirimFeedKeSheet() {
            if (!DEFAULT_SCRIPT_URL) return;
            const activePosts = listFeedsPost.filter(p => !p.isDeleted).slice(0, 15);
            setStatusSyncCloud('syncing', 'Mengirim Linimasa...');
            try {
                for (let post of activePosts) {
                    await kirimSingleFeedPostKeSheet(post);
                    await new Promise(r => setTimeout(r, 120));
                }
                setStatusSyncCloud('synced', 'Tersinkron Cloud');
                playBeepSound(1000, 'sine', 0.15);
                tampilToastCeria("Linimasa SIXBOOK berhasil disinkronkan ke Google Sheet! ☁️", "success", "☁️");
            } catch (e) {
                setStatusSyncCloud('offline', 'Gagal Sinkron');
                tampilToastCeria("Gagal mengirim linimasa ke Cloud. Periksa koneksi internet.", "error", "⚠️");
            }
        }

        async function tarikFeedDariSheet(isManual = false) {
            if (!DEFAULT_SCRIPT_URL) return;
            if (isManual) setStatusSyncCloud('syncing', 'Menarik Feed Cloud...');
            try {
                const response = await fetch(`${DEFAULT_SCRIPT_URL}?action=getChatMessages`);
                const result = await response.json();

                if (result && (result.status === 'success' || Array.isArray(result.data))) {
                    const dataArray = Array.isArray(result.data) ? result.data : (Array.isArray(result) ? result : []);
                    const postMap = {};
                    listFeedsPost.forEach(p => { postMap[p.id] = p; });

                    let hasFeedUpdates = false;
                    let newestIncomingPost = null;

                    dataArray.forEach(row => {
                        if (String(row.grup || "") === "SIXBOOK_FEED" && row.pesan) {
                            try {
                                const parsed = typeof row.pesan === 'string' ? JSON.parse(row.pesan) : row.pesan;
                                if (parsed && parsed.id) {
                                    if (parsed.foto) parsed.foto = normalizePhotoUrlFromSheet(parsed.foto);
                                    if (!Array.isArray(parsed.reposts)) parsed.reposts = [];
                                    const existing = postMap[parsed.id];
                                    if (!existing) {
                                        if (!parsed.isDeleted && loggedInNis && parsed.nis !== loggedInNis && parsed.nis !== ADMIN_NIS) {
                                            newestIncomingPost = parsed;
                                        }
                                        postMap[parsed.id] = parsed;
                                        hasFeedUpdates = true;
                                    } else {
                                        const isChanged =
                                            Boolean(parsed.isDeleted) !== Boolean(existing.isDeleted) ||
                                            (parsed.comments?.length || 0) !== (existing.comments?.length || 0) ||
                                            (parsed.likes?.length || 0) !== (existing.likes?.length || 0) ||
                                            (parsed.reposts?.length || 0) !== (existing.reposts?.length || 0) ||
                                            JSON.stringify(parsed.quiz?.responses || {}) !== JSON.stringify(existing.quiz?.responses || {});
                                        if (isChanged) {
                                            postMap[parsed.id] = parsed;
                                            hasFeedUpdates = true;
                                        }
                                    }
                                }
                            } catch (e) {}
                        }
                    });

                    prosesDataRegistryAlumniDariSheet(dataArray);
                    prosesDataFotoSampulDariSheet(dataArray);
                    prosesDataChatAdminDariSheet(dataArray);

                    if (hasFeedUpdates) {
                        const mergedList = Object.values(postMap);
                        mergedList.sort((a, b) => {
                            const idA = parseInt(String(a.id).replace(/[^\d]/g, '')) || 0;
                            const idB = parseInt(String(b.id).replace(/[^\d]/g, '')) || 0;
                            return idB - idA;
                        });
                        listFeedsPost = mergedList;
                        await simpanFeedsKeIndexedDB(listFeedsPost);

                        if (newestIncomingPost) triggerBubbleNotif(newestIncomingPost);
                        perbaruiBannerBerandaFeed();
                        updateBadgeJumlahSebutan();
                        renderFeedsStatusUI();
                    }

                    setStatusSyncCloud('synced', 'Tersinkron Cloud');
                    if (isManual) {
                        playBeepSound(950, 'sine', 0.14);
                        tampilToastCeria("Feed, Kuis, Sampul & Chat Admin diperbarui dari Cloud! 🎃", "success", "🔄");
                    }
                }
            } catch (e) {
                setStatusSyncCloud('offline', 'Mode Cache Lokal');
                if (isManual) tampilToastCeria("Gagal menarik feed dari Cloud. Menggunakan data lokal.", "warning", "⚠️");
            }
        }

        function getTopJuaraSiswaNis() {
            let maxAvg = -1;
            let topNis = null;
            listMasterSiswa.forEach(s => {
                const nis = String(s[0]);
                const pData = dbProfilDetail[nis];
                if (pData && pData.nilai) {
                    const lvl = hitungLevelAkademik(pData.nilai);
                    if (lvl.rata > 0 && lvl.rata > maxAvg) {
                        maxAvg = lvl.rata;
                        topNis = nis;
                    }
                }
            });
            return topNis;
        }

