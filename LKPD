        async function tolakAtauHapusAlumniAdmin(alumniId, isRejectFromQueue = true) {
            if (!isAdminMode) return;
            const target = listAlumniTerdaftar.find(a => a.id === alumniId);
            if (!target) return;

            const pesanKonfirm = isRejectFromQueue
                ? `Tolak dan hapus pendaftaran alumni "${target.nama}" (@${target.username}) dari daftar antrian?`
                : `Hapus akun alumni "${target.nama}" (@${target.username}) dari daftar terdaftar?`;
            const setuju = await tampilKonfirmasiCeria(pesanKonfirm, isRejectFromQueue ? "Tolak Pendaftaran Alumni" : "Hapus Akun Alumni", "❌");
            if (!setuju) return;

            const rejectedSnapshot = { ...target, status: "rejected" };
            listAlumniTerdaftar = listAlumniTerdaftar.filter(a => a.id !== alumniId);
            knownPendingAlumniIds.delete(alumniId);

