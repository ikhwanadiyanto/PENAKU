<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SIXBOOK (Social Media For Six Classmate) - v4 • Helooween Edition</title>
    <!-- Fonts & Icons -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800;900&family=Fredoka:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#fff7ed',
                            100: '#ffedd5',
                            500: '#f97316',
                            600: '#ea580c',
                            700: '#c2410c',
                        }
                    },
                    fontFamily: {
                        sans: ['Poppins', 'sans-serif'],
                        cute: ['Fredoka', 'Poppins', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        *, *::before, *::after { box-sizing: border-box; }
        body {
            background:
                radial-gradient(circle at 12% 18%, rgba(249, 115, 22, 0.24) 0%, transparent 38%),
                radial-gradient(circle at 88% 14%, rgba(163, 230, 53, 0.16) 0%, transparent 36%),
                radial-gradient(circle at 78% 85%, rgba(168, 85, 247, 0.28) 0%, transparent 42%),
                linear-gradient(135deg, #1e1338 0%, #2d1654 34%, #4c1d69 66%, #1f173a 100%);
            min-height: 100vh;
            color: #1e293b;
            overflow-x: hidden;
            position: relative;
            font-family: 'Poppins', sans-serif;
            margin: 0;
        }
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: rgba(255, 247, 237, 0.5); border-radius: 99px; }
        ::-webkit-scrollbar-thumb { background: rgba(249, 115, 22, 0.45); border-radius: 99px; }
        ::-webkit-scrollbar-thumb:hover { background: rgba(126, 34, 206, 0.65); }

        .floating-emoji-container {
            position: fixed;
            inset: 0;
            pointer-events: none !important;
            z-index: 0;
            overflow: hidden;
        }
        .floating-emoji {
            position: absolute;
            bottom: -56px;
            font-size: 26px;
            pointer-events: none !important;
            animation: floatUpEmoji 8s linear infinite;
            opacity: 0.65;
            filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.35));
        }
        @keyframes floatUpEmoji {
            0% { transform: translateY(0) rotate(0deg) scale(0.85); opacity: 0; }
            18% { opacity: 0.72; }
            82% { opacity: 0.72; }
            100% { transform: translateY(-112vh) rotate(360deg) scale(1.25); opacity: 0; }
        }
        .glass-panel {
            background: rgba(255, 251, 245, 0.97);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 2px solid rgba(251, 146, 60, 0.45);
            box-shadow: 0 12px 32px rgba(10, 6, 24, 0.34);
            position: relative;
            z-index: 10;
        }
        #modalBubbleLogin {
            z-index: 9000 !important;
            pointer-events: auto !important;
        }
        #modalBubbleLogin .glass-panel {
            z-index: 9010 !important;
            pointer-events: auto !important;
        }
        .cheerful-header {
            background: linear-gradient(135deg, #581c87 0%, #7e22ce 28%, #ea580c 68%, #f59e0b 100%);
            box-shadow: 0 14px 36px rgba(15, 8, 36, 0.45);
            border: 2px solid rgba(253, 224, 71, 0.45);
        }
        .logo-emoji-anim {
            display: inline-block;
            animation: cheerfulBounce 2.6s infinite cubic-bezier(0.68, -0.55, 0.265, 1.55);
            transform-origin: center bottom;
        }
        @keyframes cheerfulBounce {
            0%, 100% { transform: translateY(0) scale(1) rotate(0deg); }
            30% { transform: translateY(-8px) scale(1.12) rotate(-6deg); }
            50% { transform: translateY(0) scale(0.96) rotate(4deg); }
            70% { transform: translateY(-4px) scale(1.04) rotate(-2deg); }
        }
        .heart-pulse { animation: heartBeatPulse 1.2s infinite ease-in-out; display: inline-block; }
        @keyframes heartBeatPulse {
            0%, 28%, 70% { transform: scale(1); filter: drop-shadow(0 0 2px rgba(244, 63, 94, 0.45)); }
            14% { transform: scale(1.25); filter: drop-shadow(0 0 8px rgba(244, 63, 94, 0.85)); }
            42% { transform: scale(1.15); filter: drop-shadow(0 0 6px rgba(244, 63, 94, 0.65)); }
        }
        .heart-bar-fill { transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.4s ease; }
        .xp-shine { animation: xpPulse 2s infinite alternate; }
        @keyframes xpPulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 4px rgba(168, 85, 247, 0.45)); }
            100% { transform: scale(1.18); filter: drop-shadow(0 0 10px rgba(168, 85, 247, 0.85)); }
        }
        .photo-frame-box {
            aspect-ratio: 1/1; position: relative; border-radius: 24px; overflow: visible;
            border: 4px solid #fb923c; box-shadow: 0 8px 22px rgba(249, 115, 22, 0.28);
            transition: all 0.3s ease;
        }
        .photo-frame-box:hover {
            border-color: #a3e635; box-shadow: 0 10px 26px rgba(163, 230, 53, 0.35);
            transform: scale(1.02) rotate(1deg);
        }
        @keyframes goldenFrameGlow {
            0%, 100% { border-color: #f97316; box-shadow: 0 0 20px rgba(249, 115, 22, 0.8); }
            50% { border-color: #fde047; box-shadow: 0 0 30px rgba(253, 224, 71, 0.9); }
        }
        .photo-frame-box.top-rank-glow { animation: goldenFrameGlow 2s infinite ease-in-out !important; border-width: 5px !important; }
        .admin-glow-badge {
            background: linear-gradient(135deg, #7e22ce, #ea580c);
            box-shadow: 0 0 12px rgba(234, 88, 12, 0.55);
            animation: adminGlowPulse 2s infinite alternate;
        }
        .alumni-glow-badge {
            background: linear-gradient(135deg, #0d9488, #0284c7);
            box-shadow: 0 0 10px rgba(13, 148, 136, 0.45);
        }
        @keyframes adminGlowPulse { 0% { transform: scale(1); } 100% { transform: scale(1.05); } }
        .badge-box-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
        @media (min-width: 640px) { .badge-box-grid { grid-template-columns: repeat(5, 1fr); gap: 14px; } }
        .badge-item-box {
            aspect-ratio: 1/1; border-radius: 18px; background: #ffffff; border: 2px dashed #cbd5e1;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            cursor: pointer; transition: all 0.25s ease; user-select: none; position: relative; overflow: hidden;
        }
        .badge-item-box:hover { border-color: #a855f7; background: #faf5ff; transform: translateY(-4px) rotate(1deg); }
        .badge-item-box.active {
            border-style: solid; border-color: #f97316;
            background: linear-gradient(135deg, #ffedd5, #fef08a);
            box-shadow: 0 6px 16px rgba(249, 115, 22, 0.25);
        }
        .badge-action-bar { opacity: 1; background: linear-gradient(to bottom, rgba(15, 23, 42, 0.78), transparent); }
        @media (min-width: 768px) {
            .badge-action-bar { opacity: 0; background: rgba(15, 23, 42, 0.68); inset: 0; align-items: center; justify-content: center; }
            .badge-item-box:hover .badge-action-bar, .badge-item-box:focus-within .badge-action-bar { opacity: 1; }
        }
        .star-shine { animation: starPulse 2s infinite alternate; }
        @keyframes starPulse {
            0% { transform: scale(1); filter: drop-shadow(0 0 4px rgba(249, 115, 22, 0.5)); }
            100% { transform: scale(1.2); filter: drop-shadow(0 0 12px rgba(253, 224, 71, 0.9)); }
        }
        .xp-bar-fill { transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
        .tab-btn { position: relative; transition: all 0.2s ease; white-space: nowrap; flex-shrink: 0; }
        .tab-btn.active { color: #c2410c; font-weight: 800; background: rgba(255, 237, 213, 0.65); }
        .tab-btn.active::after {
            content: ''; position: absolute; bottom: -4px; left: 8px; right: 8px; height: 4px;
            background: linear-gradient(90deg, #9333ea, #f97316, #a3e635); border-radius: 99px;
        }
        .feed-chat-bubble {
            background: #ffffff; border: 2px solid #fed7aa; border-radius: 22px; border-top-left-radius: 4px;
            box-shadow: 0 6px 20px rgba(30, 19, 56, 0.08); position: relative; max-width: 100%; min-width: 0;
            overflow: hidden; transition: all 0.3s ease;
        }
        .feed-chat-bubble:hover { border-color: #fb923c; box-shadow: 0 10px 26px rgba(30, 19, 56, 0.13); }
        .feed-chat-bubble-reply {
            background: #faf5ff; border: 1px solid #e9d5ff; border-radius: 16px; border-top-left-radius: 4px;
            max-width: 100%; min-width: 0; transition: all 0.3s ease;
        }
        .mention-tag-twitter {
            display: inline-flex; align-items: center; gap: 2px; color: #7e22ce; background: #f3e8ff;
            border: 1px solid #d8b4fe; font-weight: 800; padding: 0 6px; border-radius: 8px;
            cursor: pointer; transition: all 0.2s ease;
        }
        .mention-tag-twitter:hover { background: #ffedd5; color: #c2410c; border-color: #fb923c; transform: translateY(-1px); }
        @keyframes likePopAnim { 0% { transform: scale(1); } 45% { transform: scale(1.45); } 75% { transform: scale(0.9); } 100% { transform: scale(1); } }
        .like-pop { animation: likePopAnim 0.35s cubic-bezier(0.34, 1.56, 0.64, 1); }

        /* ANIMASI KUIS BENAR & SALAH */
        @keyframes quizCorrectCelebrate {
            0% { transform: scale(1); }
            25% { transform: scale(1.04) rotate(-1deg); box-shadow: 0 0 24px rgba(16, 185, 129, 0.65); }
            50% { transform: scale(0.98) rotate(1deg); }
            75% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }
        .quiz-correct-anim {
            animation: quizCorrectCelebrate 0.65s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        @keyframes quizWrongShake {
            0%, 100% { transform: translateX(0); }
            18% { transform: translateX(-8px) rotate(-1deg); }
            36% { transform: translateX(8px) rotate(1deg); }
            54% { transform: translateX(-6px); }
            72% { transform: translateX(6px); }
            90% { transform: translateX(-3px); }
        }
        .quiz-wrong-anim {
            animation: quizWrongShake 0.55s ease-in-out;
        }

        .dm-bubble-me {
            background: linear-gradient(135deg, #7e22ce, #ea580c); color: #ffffff;
            border-radius: 20px; border-bottom-right-radius: 4px; box-shadow: 0 4px 12px rgba(126, 34, 206, 0.22);
        }
        .dm-bubble-other {
            background: #ffffff; color: #1e293b; border: 2px solid #fed7aa;
            border-radius: 20px; border-bottom-left-radius: 4px; box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
        }
        .highlight-target-post { animation: targetHighlightPulse 2s ease-in-out 2; border-color: #f97316 !important; box-shadow: 0 0 25px rgba(249, 115, 22, 0.45) !important; }
        @keyframes targetHighlightPulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.02); } }
        .waving-goodbye-anim { animation: waveGoodbye 0.8s ease-in-out forwards !important; pointer-events: none; background: #fff5f5 !important; border-color: #fca5a5 !important; }
        @keyframes waveGoodbye {
            0% { transform: scale(1) translateY(0); opacity: 1; }
            40% { transform: scale(1.05) translateY(-6px); opacity: 0.9; }
            100% { transform: scale(0.8) translateY(-25px); opacity: 0; }
        }
        @keyframes bellShake { 0%, 100% { transform: rotate(0); } 25% { transform: rotate(15deg); } 75% { transform: rotate(-15deg); } }
        .bell-shake-active { animation: bellShake 0.4s infinite ease-in-out; color: #ea580c !important; }
        .embed-youtube-container { position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden; border-radius: 16px; box-shadow: 0 6px 16px rgba(30, 19, 56, 0.16); border: 2px solid #e9d5ff; }
        .embed-youtube-container iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
        .admin-app-btn { transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1); position: relative; overflow: hidden; }
        .admin-app-btn:hover { transform: translateY(-6px) scale(1.02); box-shadow: 0 15px 30px rgba(0, 0, 0, 0.22); }
        .admin-app-btn:active { transform: translateY(-2px) scale(0.98); }
        @keyframes toastSlideIn { 0% { transform: translateY(30px) scale(0.9); opacity: 0; } 100% { transform: translateY(0) scale(1); opacity: 1; } }
        .toast-cheerful-enter { animation: toastSlideIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) forwards; }
        @media print {
            body { background: #ffffff !important; color: #000000 !important; padding: 0 !important; }
            .no-print, .floating-emoji-container { display: none !important; }
            .print-card-area { background: #ffffff !important; color: #000000 !important; border: 2px solid #000 !important; box-shadow: none !important; margin: 0 !important; padding: 20px !important; width: 100% !important; max-width: 100% !important; border-radius: 0 !important; }
            .glass-panel { background: #ffffff !important; border: 1px solid #cbd5e1 !important; color: #000000 !important; box-shadow: none !important; }
        }
    </style>
</head>
<body class="p-3 sm:p-5 md:p-8 relative pb-20">

    <!-- WADAH DEKORASI EMOJI HELOOWEEN MELAYANG -->
    <div class="floating-emoji-container" id="floatingEmojiContainer"></div>

    <!-- TOAST NOTIFIKASI CERIA -->
    <div id="cheerfulToastContainer" class="fixed bottom-4 right-4 z-[999999] flex flex-col gap-2.5 max-w-[92vw] w-80 pointer-events-none no-print"></div>

    <!-- MODAL KONFIRMASI & INPUT CERIA -->
    <div id="cheerfulDialogModal" class="fixed inset-0 bg-slate-950/75 backdrop-blur-md flex items-center justify-center p-4 z-[999998] hidden no-print">
        <div class="glass-panel p-6 rounded-3xl max-w-sm w-full border-4 border-orange-400 shadow-2xl text-center">
            <div id="cheerfulDialogIcon" class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-gradient-to-tr from-orange-300 via-purple-200 to-lime-200 text-slate-900 flex items-center justify-center text-3xl shadow-inner logo-emoji-anim">🎃</div>
            <h4 id="cheerfulDialogTitle" class="text-base sm:text-lg font-cute font-black text-slate-900 mb-1.5">Konfirmasi SIXBOOK</h4>
            <p id="cheerfulDialogMessage" class="text-xs text-slate-700 font-medium leading-relaxed mb-4"></p>
            <input type="text" id="cheerfulDialogInput" class="hidden w-full bg-white text-slate-900 font-bold text-xs sm:text-sm border-2 border-orange-300 rounded-2xl px-4 py-3 mb-4 focus:outline-none focus:border-purple-600 shadow-inner">
            <div class="flex items-center justify-center gap-2.5">
                <button id="cheerfulDialogBtnCancel" class="flex-1 py-2.5 px-4 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs transition-all active:scale-95">Batal</button>
                <button id="cheerfulDialogBtnOk" class="flex-1 py-2.5 px-4 rounded-2xl bg-gradient-to-r from-purple-600 via-orange-500 to-amber-500 hover:opacity-95 text-white font-cute font-black text-xs shadow-md transition-all active:scale-95">Ya, Lanjutkan!</button>
            </div>
        </div>
    </div>

    <!-- MODAL MIGRASI AKUN SISWA AKTIF MENJADI ALUMNI -->
    <div id="modalMigrasiAlumni" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-4 z-[99990] hidden no-print" onclick="tutupModalMigrasiAlumni(event)">
        <div class="glass-panel p-5 sm:p-6 rounded-3xl max-w-2xl w-full border-4 border-teal-400 shadow-2xl relative max-h-[92vh] flex flex-col" onclick="event.stopPropagation()">
            <div class="flex items-center justify-between pb-3 border-b border-teal-200 mb-4 shrink-0">
                <div class="flex items-center gap-2.5">
                    <div class="w-11 h-11 rounded-2xl bg-gradient-to-tr from-teal-600 via-cyan-500 to-purple-600 text-white flex items-center justify-center text-xl shadow-md">🎓</div>
                    <div>
                        <h3 class="text-base sm:text-lg font-cute font-black text-slate-900">Migrasi Akun Siswa Aktif → Alumni</h3>
                        <p class="text-[11px] text-teal-800 font-semibold">Konversi akun siswa kelas 6 menjadi akun Alumni Terverifikasi (Approved) otomatis</p>
                    </div>
                </div>
                <button type="button" onclick="tutupModalMigrasiAlumni()" class="w-8 h-8 rounded-full bg-rose-100 hover:bg-rose-200 text-rose-600 flex items-center justify-center font-bold text-sm transition-all">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <div class="overflow-y-auto pr-1 space-y-4 flex-1">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 bg-teal-50/90 p-3.5 rounded-2xl border border-teal-200">
                    <div>
                        <label class="block text-[11px] font-black text-teal-950 mb-1">Tahun Lulus / Angkatan Alumni:</label>
                        <input type="text" id="inputMigrasiAngkatan" value="2026" placeholder="Contoh: 2026" class="w-full bg-white text-slate-900 font-bold text-xs border-2 border-teal-300 rounded-xl px-3 py-2 focus:outline-none focus:border-purple-600 shadow-inner">
                    </div>
                    <div>
                        <label class="block text-[11px] font-black text-teal-950 mb-1">PIN / Password Default Alumni:</label>
                        <select id="selectMigrasiPasswordMode" class="w-full bg-white text-slate-900 font-bold text-xs border-2 border-teal-300 rounded-xl px-3 py-2 focus:outline-none focus:border-purple-600 shadow-inner">
                            <option value="nis">Gunakan NIS Siswa (Paling Mudah Diingat)</option>
                            <option value="2026">Gunakan Kode Tahun Angkatan (2026)</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-amber-50/90 p-3 rounded-2xl border border-amber-300">
                    <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-amber-950 select-none">
                        <input type="checkbox" id="checkMigrasiPindahRiwayat" checked class="w-4 h-4 accent-teal-600 rounded cursor-pointer">
                        <span>Salin Foto Profil, Bintang, XP & Riwayat Chat Admin ke Akun Alumni</span>
                    </label>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-black text-slate-900 flex items-center gap-1.5">
                            <i class="fa-solid fa-user-graduate text-teal-600"></i> Pilih Siswa Aktif yang Akan Dimigrasi:
                        </span>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="pilihSemuaSiswaMigrasi(true)" class="text-[11px] font-black text-teal-700 hover:underline">Pilih Semua (27)</button>
                            <span class="text-slate-300">|</span>
                            <button type="button" onclick="pilihSemuaSiswaMigrasi(false)" class="text-[11px] font-bold text-slate-500 hover:underline">Kosongkan</button>
                        </div>
                    </div>
                    <div id="containerListSiswaMigrasi" class="grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-60 overflow-y-auto p-2.5 bg-slate-100/90 rounded-2xl border border-slate-200 text-xs"></div>
                </div>

                <div id="boxProgressMigrasiAlumni" class="hidden p-3 rounded-2xl bg-purple-50 border-2 border-purple-300 space-y-1.5">
                    <div class="flex items-center justify-between text-[11px] font-black text-purple-950">
                        <span id="lblStatusMigrasiAlumni"><i class="fa-solid fa-spinner fa-spin text-orange-500 mr-1"></i> Memproses migrasi...</span>
                        <span id="lblPersenMigrasiAlumni">0%</span>
                    </div>
                    <div class="w-full bg-purple-200 h-2.5 rounded-full overflow-hidden">
                        <div id="barProgressMigrasiAlumni" class="h-full bg-gradient-to-r from-teal-500 via-purple-600 to-orange-500 transition-all duration-300" style="width: 0%"></div>
                    </div>
                </div>
            </div>

            <div class="pt-3 border-t border-slate-200 flex items-center justify-end gap-2 mt-3 shrink-0">
                <button type="button" onclick="tutupModalMigrasiAlumni()" class="px-4 py-2.5 rounded-2xl bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold text-xs transition-all">Batal</button>
                <button type="button" id="btnEksekusiMigrasiAlumni" onclick="eksekusiMigrasiSiswaKeAlumni()" class="px-5 py-2.5 rounded-2xl bg-gradient-to-r from-teal-600 via-cyan-600 to-purple-700 hover:opacity-95 text-white font-cute font-black text-xs shadow-lg transition-all active:scale-95 flex items-center gap-1.5">
                    <i class="fa-solid fa-graduation-cap"></i> Jalankan Migrasi ke Alumni 🎓
                </button>
            </div>
        </div>
    </div>

    <!-- POPUP BUBBLE NOTIFIKASI FEED -->
    <div id="bubbleNotifToast" onclick="bukaNotifFeed()" class="hidden fixed top-4 right-4 z-[99999] bg-slate-950/95 backdrop-blur-md text-white p-3.5 rounded-2xl shadow-2xl border-2 border-orange-400 w-72 max-w-[92vw] cursor-pointer animate-bounce flex items-start gap-3">
        <div class="w-9 h-9 rounded-full bg-orange-500/20 flex items-center justify-center text-orange-300 shrink-0 text-base shadow-inner mt-0.5">🎃</div>
        <div class="flex-1 min-w-0 pr-1">
            <p class="text-xs font-black leading-tight text-amber-300 break-words" id="lblNotifBubbleTitle">Ada Posting Baru di Feed!</p>
            <p class="text-[11px] text-slate-200 font-medium leading-tight mt-1 break-words line-clamp-2" id="lblNotifBubbleSub">Klik untuk melihat pesan terbaru!</p>
        </div>
    </div>

    <!-- POPUP BUBBLE NOTIFIKASI REAL-TIME KHUSUS CHAT ADMIN 💬 -->
    <div id="bubbleNotifChatAdmin" onclick="bukaNotifChatAdmin()" class="hidden fixed top-20 right-4 z-[99999] bg-gradient-to-br from-purple-950/95 via-slate-950/95 to-orange-950/95 backdrop-blur-md text-white p-3.5 rounded-2xl shadow-2xl border-2 border-pink-400 w-80 max-w-[92vw] cursor-pointer flex items-start gap-3 transition-all hover:scale-[1.02]">
        <div class="w-10 h-10 rounded-2xl bg-gradient-to-tr from-pink-600 to-orange-500 flex items-center justify-center text-white shrink-0 text-lg shadow-md mt-0.5">💬</div>
        <div class="flex-1 min-w-0 pr-1">
