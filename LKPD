                            <button type="button" onclick="editNamaBadge(${i}, event)" class="w-7 h-7 rounded-lg bg-amber-500 hover:bg-amber-600 text-white text-xs flex items-center justify-center shadow-sm"><i class="fa-solid fa-pen"></i></button>
                            <button type="button" onclick="picuUploadFotoBadge(${i}, event)" class="w-7 h-7 rounded-lg bg-purple-700 hover:bg-purple-800 text-white text-xs flex items-center justify-center shadow-sm"><i class="fa-solid fa-camera"></i></button>
                        </div>` : ''}
                        <div class="text-2xl mb-1 flex items-center justify-center w-12 h-12 rounded-xl overflow-hidden pointer-events-none">
                            ${isImg ? `<img src="${badge.img}" class="w-full h-full object-cover ${badge.active ? '' : 'grayscale opacity-50'}">` :
