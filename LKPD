            const clean = String(nama || '').toLowerCase().replace(/[^a-z0-9\s]/g, '').trim().split(/\s+/);
            if (!clean[0]) return '@teman';
            return '@' + clean[0] + (clean[1] ? '_' + clean[1].slice(0, 5) : '');
        }

