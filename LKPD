            if (e) e.preventDefault();
            const userIn = document.getElementById('inputAlumniLoginUser').value.trim().toLowerCase().replace(/^@/, '');
            const passIn = document.getElementById('inputAlumniLoginPass').value.trim();
            const simpanAkun = document.getElementById('checkIngatAlumni').checked;

            await tarikRegistryAlumniDariSheet(false);

            const found = listAlumniTerdaftar.find(a =>
                (a.username.toLowerCase() === userIn || a.nama.toLowerCase() === userIn) &&
                String(a.password) === passIn
            );

            if (!found) {
                tampilToastCeria("Username atau Password Alumni tidak cocok! Cek kembali atau daftar akun baru.", "error", "❌");
                playBeepSound(300, 'sawtooth', 0.18);
                return;
            }

            if (simpanAkun) {
                localStorage.setItem("saved_alumni_user", found.username);
                localStorage.setItem("saved_alumni_pass", found.password);
            } else {
                localStorage.removeItem("saved_alumni_user");
                localStorage.removeItem("saved_alumni_pass");
