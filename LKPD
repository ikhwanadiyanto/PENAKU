        function prosesDataFotoSampulDariSheet(dataArray) {
            if (!Array.isArray(dataArray)) return;
            let hasUpdates = false;
            dataArray.forEach(row => {
                const grupName = String(row.grup || "").trim();
                if (grupName.toLowerCase() === "foto sampul" && row.pesan) {
                    try {
                        const parsed = typeof row.pesan === 'string' ? JSON.parse(row.pesan) : row.pesan;
                        const targetNis = String(parsed.nis || row.nis || "").trim();
                        const coverImg = normalizePhotoUrlFromSheet(parsed.coverFoto || parsed.foto || "");
                        const rowTs = parseInt(parsed.updatedAt) || (parseInt(String(row.id || "0").replace(/[^\d]/g, '')) || 0);
                        if (targetNis && coverImg) {
                            const existing = dbCoverPhotos[targetNis];
                            if (!existing || rowTs >= (existing.updatedAt || 0)) {
                                dbCoverPhotos[targetNis] = {
                                    nis: targetNis,
                                    coverFoto: coverImg,
                                    updatedAt: rowTs
                                };
                                if (targetNis === ADMIN_NIS || targetNis === 'admin') {
                                    dbCoverPhotos[ADMIN_NIS] = { nis: ADMIN_NIS, coverFoto: coverImg, updatedAt: rowTs };
                                    dbCoverPhotos['admin'] = { nis: 'admin', coverFoto: coverImg, updatedAt: rowTs };
                                }
                                hasUpdates = true;
                            }
                        }
                    } catch (e) {}
                }
            });

            if (hasUpdates) {
                simpanCoverPhotosSemuaStorage();
                if (loggedInNis) perbaruiBannerBerandaFeed();
            }
        }

