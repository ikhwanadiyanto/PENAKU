        /* ==================== INDEXEDDB CACHE (SixbookCacheDB_v2) ==================== */
        function bukaIndexedDB() {
            return new Promise((resolve, reject) => {
                if (idbInstance) return resolve(idbInstance);
                const req = indexedDB.open("SixbookCacheDB_v2", 6);
                req.onupgradeneeded = (e) => {
                    const db = e.target.result;
                    if (!db.objectStoreNames.contains("feeds")) db.createObjectStore("feeds", { keyPath: "id" });
                    if (!db.objectStoreNames.contains("profilStore")) db.createObjectStore("profilStore", { keyPath: "nis" });
                    if (!db.objectStoreNames.contains("chatAdminStore")) db.createObjectStore("chatAdminStore", { keyPath: "siswaNis" });
                    if (!db.objectStoreNames.contains("alumniStore")) db.createObjectStore("alumniStore", { keyPath: "id" });
                    if (!db.objectStoreNames.contains("coverStore")) db.createObjectStore("coverStore", { keyPath: "nis" });
                };
                req.onsuccess = (e) => { idbInstance = e.target.result; resolve(idbInstance); };
                req.onerror = (e) => reject(e.target.error);
            });
        }

        async function simpanCoversKeIndexedDB(coversMap) {
            try {
                const db = await bukaIndexedDB();
                const tx = db.transaction(["coverStore"], "readwrite");
                const store = tx.objectStore("coverStore");
                Object.keys(coversMap).forEach(k => {
                    if (coversMap[k] && coversMap[k].coverFoto) {
                        store.put({ nis: String(k), ...coversMap[k] });
                    }
                });
            } catch (e) {}
        }

        async function muatCoversDariIndexedDB() {
            try {
                const db = await bukaIndexedDB();
                const tx = db.transaction(["coverStore"], "readonly");
                const store = tx.objectStore("coverStore");
                const req = store.getAll();
                return new Promise((resolve) => {
                    req.onsuccess = () => {
                        const out = {};
                        (req.result || []).forEach(r => { if (r && r.nis) out[r.nis] = r; });
                        resolve(out);
                    };
                    req.onerror = () => resolve({});
                });
            } catch (e) { return {}; }
        }

