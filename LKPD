            grid.innerHTML = MAPEL_LIST.map(m => {
                const val = parseFloat(nilaiObj[m.id]) || 0;
                return `
                    <div class="bg-white p-3 rounded-2xl border border-orange-200 flex flex-col gap-1 shadow-xs">
