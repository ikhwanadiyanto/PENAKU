        function prosesUploadFotoProfilSiswa(e) {
            const file = e.target.files[0];
            if (!file || !currentNis) return;
            if (!validasiUkuranFoto(file)) { e.target.value = ''; return; }
            const reader = new FileReader();
            reader.onload = function(evt) {
                const img = new Image();
                img.onload = function() {
                    const canvas = document.createElement('canvas');
                    canvas.width = 250; canvas.height = 250;
                    const ctx = canvas.getContext('2d');
                    const size = Math.min(img.width, img.height);
                    ctx.drawImage(img, (img.width - size) / 2, (img.height - size) / 2, size, size, 0, 0, 250, 250);
                    const b64 = canvas.toDataURL('image/jpeg', 0.8);
                    dbProfilDetail[currentNis].fotoProfil = b64;
                    if (currentNis === 'admin') {
                        if (!dbProfilDetail[ADMIN_NIS]) dbProfilDetail[ADMIN_NIS] = { ...dbProfilDetail['admin'] };
                        dbProfilDetail[ADMIN_NIS].fotoProfil = b64;
                    }
                    if (isAlumniId(currentNis)) {
                        const alm = listAlumniTerdaftar.find(a => a.id === currentNis);
                        if (alm) {
                            alm.fotoProfil = b64;
                            simpanDaftarAlumniSemuaStorage();
                            kirimAlumniRegistryKeSheet(alm, "photo");
                        }
                    }
                    simpanSemuaData();
                    gantiSiswaProfil(currentNis);
                    renderFormPostUser();
                    perbaruiBannerBerandaFeed();
                    renderFeedsStatusUI();
                    playBeepSound(950, 'sine', 0.14);
                    tampilToastCeria("Foto profil baru berhasil dipasang! 📷✨", "success", "📷");
                    e.target.value = '';
                    kirimDataProfilLengkapKeSheet(currentNis);
                };
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        }

