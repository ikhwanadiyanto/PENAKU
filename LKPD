        function prosesUploadFotoSampul(e) {
            const file = e.target.files[0];
            if (!file || !loggedInNis) return;
            if (!validasiUkuranFoto(file)) { e.target.value = ''; return; }

            const myAccountNis = isAdminMode ? ADMIN_NIS : String(loggedInNis);
            const targetNis = (isAdminMode && activeFriendFeedNis) ? String(activeFriendFeedNis) : myAccountNis;

            const reader = new FileReader();
            reader.onload = function(evt) {
                const img = new Image();
                img.onload = async function() {
                    // Kompresi otomatis proporsional ringan untuk banner sampul (800x260, kualitas 0.72)
                    const canvas = document.createElement('canvas');
                    const TARGET_W = 800;
                    const TARGET_H = 260;
                    canvas.width = TARGET_W;
                    canvas.height = TARGET_H;
                    const ctx = canvas.getContext('2d');

                    const targetRatio = TARGET_W / TARGET_H;
                    const imgRatio = img.width / img.height;
                    let sx = 0, sy = 0, sw = img.width, sh = img.height;

                    if (imgRatio > targetRatio) {
                        sw = img.height * targetRatio;
                        sx = (img.width - sw) / 2;
                    } else {
                        sh = img.width / targetRatio;
                        sy = (img.height - sh) / 2;
                    }

                    ctx.drawImage(img, sx, sy, sw, sh, 0, 0, TARGET_W, TARGET_H);
                    const compressedCoverBase64 = canvas.toDataURL('image/jpeg', 0.72);
                    const nowTs = Date.now();

                    dbCoverPhotos[targetNis] = {
                        nis: targetNis,
                        coverFoto: compressedCoverBase64,
                        updatedAt: nowTs
                    };
                    if (targetNis === ADMIN_NIS || targetNis === 'admin') {
                        dbCoverPhotos[ADMIN_NIS] = { nis: ADMIN_NIS, coverFoto: compressedCoverBase64, updatedAt: nowTs };
                        dbCoverPhotos['admin'] = { nis: 'admin', coverFoto: compressedCoverBase64, updatedAt: nowTs };
                    }

                    await simpanCoverPhotosSemuaStorage();
                    perbaruiBannerBerandaFeed();
                    playBeepSound(1050, 'sine', 0.16);
                    tampilToastCeria("Foto sampul dikompresi ringan & dikirim ke grup \"Foto sampul\"! 🖼️✨", "success", "🖼️");
                    e.target.value = '';

                    await kirimFotoSampulKeSheet(targetNis, compressedCoverBase64, nowTs);
                };
                img.src = evt.target.result;
            };
            reader.readAsDataURL(file);
        }

