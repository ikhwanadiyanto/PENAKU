        async function terapkanBadgeMassal() {
            const idx = parseInt(document.getElementById('selectMassalBadgeIndex').value);
            const newTitle = document.getElementById('inputMassalNamaBadge').value.trim() || BADGE_DESCS[idx];
            const isAktifkan = document.getElementById('checkMassalAktifkan').checked;
            const checkedBoxes = document.querySelectorAll('.chk-siswa-massal:checked');
            if (checkedBoxes.length === 0) {
                tampilToastCeria("Pilih minimal 1 siswa penerima badge!", "warning", "👥");
                return;
            }

            isEditingOrSavingBadge = true;
            BADGE_DESCS[idx] = newTitle;
            const selectedNisList = [];

            checkedBoxes.forEach(chk => {
                const nis = String(chk.value);
                selectedNisList.push(nis);
                lastBadgeLocalSaveTime[nis] = Date.now();
                if (dbProfilDetail[nis]?.badges?.[idx]) {
                    dbProfilDetail[nis].badges[idx].title = newTitle;
                    dbProfilDetail[nis].badges[idx].active = isAktifkan;
                    if (tempMassalBase64) dbProfilDetail[nis].badges[idx].img = tempMassalBase64;
                }
            });

            simpanSemuaData();
            if (currentNis && currentNis !== 'admin') renderBadgesSiswa();
            tutupModalBadgeMassal();
            playBeepSound(1100, 'sine', 0.2);
            tampilToastCeria(`Badge "${newTitle}" berhasil diterapkan ke ${selectedNisList.length} siswa! 🏅`, "success", "🏅");

            for (let n of selectedNisList) { await kirimDataProfilLengkapKeSheet(n); await new Promise(r => setTimeout(r, 150)); }
            setTimeout(() => { isEditingOrSavingBadge = false; }, 3500);
        }

        /* ==================== PELANGGARAN & HEART METER ==================== */
        function renderPelanggaranSiswa() {
            const tbody = document.getElementById('tbodyPelanggaran');
            const thHead = document.getElementById('thSiswaNamaHead');
            const isAdminProfile = (currentNis === 'admin');
            let skorHp = 100;

            if (isAdminProfile) {
                thHead.innerText = "Nama Siswa & Tanggal";
                let allViolations = [];
                listMasterSiswa.forEach(s => {
                    const nis = String(s[0]);
                    const pData = dbProfilDetail[nis];
                    if (pData && Array.isArray(pData.pelanggaran)) {
                        pData.pelanggaran.forEach((item, idx) => { allViolations.push({ nis, nama: s[1], idx, ...item }); });
                    }
                });
                const totalPoin = allViolations.reduce((sum, v) => sum + (parseInt(v.poin) || 0), 0);
                skorHp = Math.max(0, 100 - totalPoin);

                if (allViolations.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-emerald-700 font-bold italic">Seluruh siswa tertib! Belum ada pelanggaran tercatat. ✨</td></tr>`;
                } else {
                    tbody.innerHTML = allViolations.map(v => `
                        <tr class="border-b border-slate-200 hover:bg-rose-50/70 transition-colors">
                            <td class="py-2.5 px-3">
                                <span class="font-bold text-slate-900 block">${v.nama}</span>
                                <span class="text-[10px] text-slate-500 font-mono">${v.tgl}</span>
                            </td>
                            <td class="py-2.5 px-3 font-medium text-slate-800">${v.jenis}</td>
                            <td class="py-2.5 px-3 text-center"><span class="bg-rose-100 text-rose-800 border border-rose-200 font-bold px-2.5 py-0.5 rounded-full">-${v.poin}</span></td>
                            <td class="py-2.5 px-3 text-right no-print admin-only">
                                <button onclick="hapusPelanggaranByNis('${v.nis}', ${v.idx})" class="text-slate-400 hover:text-rose-600"><i class="fa-solid fa-trash-can"></i></button>
                            </td>
                        </tr>
                    `).join('');
                }
            } else {
                thHead.innerText = "Tanggal";
                const pData = dbProfilDetail[currentNis];
                if (!pData) return;
                let totalPengurangan = 0;
                if (!pData.pelanggaran || pData.pelanggaran.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-emerald-700 font-bold italic">Hebat! Belum ada catatan pelanggaran kedisiplinan. 🎉</td></tr>`;
                } else {
                    tbody.innerHTML = pData.pelanggaran.map((item, idx) => {
                        totalPengurangan += parseInt(item.poin) || 0;
                        return `
                            <tr class="border-b border-slate-200 hover:bg-rose-50/70 transition-colors">
                                <td class="py-2.5 px-3 font-mono text-slate-600 font-semibold">${item.tgl}</td>
                                <td class="py-2.5 px-3 font-bold text-slate-900">${item.jenis}</td>
                                <td class="py-2.5 px-3 text-center"><span class="bg-rose-100 text-rose-800 border border-rose-200 font-bold px-2.5 py-0.5 rounded-full">-${item.poin}</span></td>
                                <td class="py-2.5 px-3 text-right no-print admin-only">
                                    <button onclick="hapusPelanggaran(${idx})" class="text-slate-400 hover:text-rose-600"><i class="fa-solid fa-trash-can"></i></button>
                                </td>
                            </tr>
                        `;
                    }).join('');
                }
                skorHp = Math.max(0, 100 - totalPengurangan);
            }

            document.getElementById('lblSkorSikap').innerText = `Skor Kedisiplinan: ${skorHp} HP`;
            document.getElementById('lblHeartMeterText').innerText = `${skorHp} / 100 HP`;
            const barFill = document.getElementById('barHeartMeterFill');
            const heartIcon = document.getElementById('lblHeartMeterIcon');
            barFill.style.width = `${skorHp}%`;

            if (skorHp >= 80) {
                barFill.className = "heart-bar-fill h-full bg-gradient-to-r from-emerald-500 via-teal-500 to-lime-500 rounded-full";
                heartIcon.innerText = "❤️";
            } else if (skorHp >= 50) {
                barFill.className = "heart-bar-fill h-full bg-gradient-to-r from-amber-500 to-orange-500 rounded-full";
                heartIcon.innerText = "🧡";
            } else {
                barFill.className = "heart-bar-fill h-full bg-gradient-to-r from-rose-600 to-red-600 rounded-full";
                heartIcon.innerText = "💔";
            }

            perbaruiBannerBerandaFeed();
        }

        function tambahPelanggaran(e) {
            e.preventDefault();
            if (!isAdminMode || !currentNis || currentNis === 'admin') {
