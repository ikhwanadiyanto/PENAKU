        function normalizePhotoUrlFromSheet(rawUrl) {
            if (!rawUrl) return "";
            const str = String(rawUrl).trim();
            if (!str || str === "undefined" || str === "null") return "";
            if (str.startsWith("data:image/")) return str;
            if (str.startsWith("http://") || str.startsWith("https://")) {
                const driveMatch1 = str.match(/\/file\/d\/([a-zA-Z0-9_-]+)/);
                if (driveMatch1 && driveMatch1[1]) {
                    return `https://drive.google.com/thumbnail?id=${driveMatch1[1]}&sz=w400`;
                }
                const driveMatch2 = str.match(/[?&]id=([a-zA-Z0-9_-]+)/);
                if (str.includes("drive.google.com") && driveMatch2 && driveMatch2[1]) {
                    return `https://drive.google.com/thumbnail?id=${driveMatch2[1]}&sz=w400`;
                }
                return str;
            }
            if (str.length > 60 && /^[A-Za-z0-9+/=]+$/.test(str.replace(/\s/g, ''))) {
                const cleanB64 = str.replace(/\s/g, '');
                if (cleanB64.startsWith("iVBOR")) return "data:image/png;base64," + cleanB64;
                if (cleanB64.startsWith("R0lGOD")) return "data:image/gif;base64," + cleanB64;
                if (cleanB64.startsWith("UklGR")) return "data:image/webp;base64," + cleanB64;
                return "data:image/jpeg;base64," + cleanB64;
            }
            return "";
        }

