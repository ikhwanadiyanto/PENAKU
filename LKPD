        function updateNilaiMapel(key, val) {
            if (!isAdminMode) return;
            const pData = dbProfilDetail[currentNis];
            if (!pData) return;
            if (!pData.nilai) pData.nilai = {};
            pData.nilai[key] = isNaN(val) || key.includes('ekskul') || key.includes('predikat') ? val : parseFloat(val);
            simpanSemuaData();
            kalkulasiDanRenderLevel();
            kirimDataProfilLengkapKeSheet(currentNis);
        }

        function hitungLevelAkademik(nilaiObj) {
            let total = 0, count = 0;
            MAPEL_LIST.forEach(m => {
                const v = parseFloat(nilaiObj[m.id]);
                if (!isNaN(v) && v > 0) { total += v; count++; }
            });
            const rata = count > 0 ? (total / count) : 0;

            let level = 1, title = "🌱 Tunas Bintang Cilik", desc = "Ayo mulai petualangan belajarmu dengan senyuman ceria!", target = "Level 2 (Rata-rata 70)", pct = (rata / 70) * 100;
            if (rata >= 95) { level = 5; title = "👑 Maha Guru Juara Helooween"; desc = "Prestasi luar biasa! Kamu adalah teladan kelas yang membanggakan!"; target = "Level Maksimal Tercapai!"; pct = 100; }
            else if (rata >= 88) { level = 4; title = "🚀 Kapten Penjelajah Ilmu"; desc = "Hebat sekali! Sedikit lagi menuju puncak Maha Guru Juara!"; target = "Level 5 (Rata-rata 95)"; pct = ((rata - 88) / 7) * 100; }
            else if (rata >= 80) { level = 3; title = "🌟 Ksatria Bintang Pelajar"; desc = "Semangat belajarmu bersinar terang! Pertahankan prestasimu!"; target = "Level 4 (Rata-rata 88)"; pct = ((rata - 80) / 8) * 100; }
            else if (rata >= 70) { level = 2; title = "🍀 Sahabat Pintar Kelas 6"; desc = "Bagus! Terus berlatih dan raih nilai lebih tinggi lagi!"; target = "Level 3 (Rata-rata 80)"; pct = ((rata - 70) / 10) * 100; }

            return { level, title, desc, target, rata, pct: Math.min(100, Math.max(0, pct)) };
        }

        function kalkulasiDanRenderLevel() {
            const pData = dbProfilDetail[currentNis];
            if (!pData || currentNis === 'admin') return;
            const info = hitungLevelAkademik(pData.nilai || {});
            document.getElementById('lblBadgeLevelName').innerText = `Level ${info.level}`;
            document.getElementById('lblLevelTitle').innerText = info.title;
            document.getElementById('lblLevelDesc').innerText = info.desc;
            document.getElementById('lblRataRataVal').innerText = info.rata.toFixed(2);
            document.getElementById('lblExpTargetText').innerText = `Target: ${info.target}`;
            document.getElementById('barExpFill').style.width = `${info.pct}%`;
        }

        /* ==================== SINKRONISASI PROFIL LENGKAP KE GOOGLE SHEET ==================== */
        async function kirimDataProfilLengkapKeSheet(targetNis) {
            if (!DEFAULT_SCRIPT_URL) return;
            const pData = dbProfilDetail[targetNis];
            if (!pData) return;

            const isAdmin = (targetNis === 'admin');
            const isAlumni = isAlumniId(targetNis);
            const alm = isAlumni ? listAlumniTerdaftar.find(a => a.id === targetNis) : null;
            const siswaObj = listMasterSiswa.find(s => String(s[0]) === String(targetNis));
            const nama = isAdmin ? (pData.nama || DEFAULT_ADMIN_NAME) : (isAlumni ? (alm ? alm.nama : pData.nama) : (siswaObj ? siswaObj[1] : ""));
            const nisKirim = isAdmin ? ADMIN_NIS : String(targetNis);

            let badgeStates = Array(25).fill(0);
            let badgeImagesObj = {};
            if (!isAdmin && Array.isArray(pData.badges)) {
                pData.badges.forEach((b, idx) => {
                    badgeStates[idx] = b.active ? 1 : 0;
                    if (b.img && b.img.startsWith("data:image/")) badgeImagesObj[idx] = b.img;
                });
            }

            if (!isKirimMassalRunning) setStatusSyncCloud('syncing', 'Menyinkronkan Profil...');
            try {
                await fetch(DEFAULT_SCRIPT_URL, {
                    method: 'POST',
                    mode: 'no-cors',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        action: "syncProfilLengkap",
                        nis: nisKirim,
                        nama: nama,
                        bintang: isAdmin ? 999 : (parseInt(pData.bintang) || 0),
                        xp: isAdmin ? 9999 : (parseInt(pData.xp ?? dbXpSiswa[targetNis]) || 0),
                        tabungan: isAdmin ? 0 : (parseFloat(pData.tabungan ?? dbTabunganSiswa[targetNis]) || 0),
                        fotoProfil: pData.fotoProfil || "",
                        badgesJson: JSON.stringify(badgeStates),
                        badgeDescsJson: JSON.stringify(BADGE_DESCS),
                        badgeImagesJson: JSON.stringify(badgeImagesObj),
                        pamerBadgeIdx: pData.pamerBadgeIdx ?? null,
                        pelanggaranJson: JSON.stringify(pData.pelanggaran || []),
                        nilaiJson: JSON.stringify(pData.nilai || {})
                    })
                });
                if (!isKirimMassalRunning) setStatusSyncCloud('synced', 'Tersinkron Cloud');
            } catch (e) {
                if (!isKirimMassalRunning) setStatusSyncCloud('offline', 'Tersimpan Lokal');
            }
        }

        async function kirimDataKeSheet() {
            if (!isAdminMode) return;
            const btnKirim = document.getElementById('btnKirimSheet');
            const progressBox = document.getElementById('containerProgressKirimMassal');
            const lblStatus = document.getElementById('lblStatusKirimMassal');
            const lblPersen = document.getElementById('lblPersenKirimMassal');
            const barProgress = document.getElementById('barProgressKirimMassal');

            isKirimMassalRunning = true;
            if (btnKirim) btnKirim.disabled = true;
            if (progressBox) progressBox.classList.remove('hidden');

            const totalSiswa = listMasterSiswa.length;
            setStatusSyncCloud('syncing', `Mengirim ${totalSiswa} Data...`);

            try {
                await kirimDataProfilLengkapKeSheet('admin');
                for (let i = 0; i < totalSiswa; i++) {
                    const nis = String(listMasterSiswa[i][0]);
                    const nama = listMasterSiswa[i][1];
                    const urutan = i + 1;
                    const persen = Math.round((urutan / totalSiswa) * 100);

                    if (lblStatus) lblStatus.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-lime-300"></i> Mengirim (${urutan}/${totalSiswa}): ${nama}`;
                    if (lblPersen) lblPersen.innerText = `${urutan} / ${totalSiswa} (${persen}%)`;
                    if (barProgress) barProgress.style.width = `${persen}%`;

                    await kirimDataProfilLengkapKeSheet(nis);
                    await new Promise(r => setTimeout(r, 150));
                }

                for (let alm of getApprovedAlumniList()) {
                    await kirimDataProfilLengkapKeSheet(alm.id);
                    await new Promise(r => setTimeout(r, 100));
                }

                if (lblStatus) lblStatus.innerHTML = `<i class="fa-solid fa-circle-check text-lime-300"></i> Pengiriman Selesai! Seluruh data tersinkronisasi.`;
                setStatusSyncCloud('synced', 'Tersinkron Cloud');
                playBeepSound(1200, 'sine', 0.25);
                tampilToastCeria(`Seluruh ${totalSiswa} data siswa & alumni berhasil dikirim ke Google Sheet! ☁️✨`, "success", "🚀");

                setTimeout(() => { if (progressBox) progressBox.classList.add('hidden'); }, 2200);
            } catch (err) {
                setStatusSyncCloud('offline', 'Gagal Kirim Massal');
                tampilToastCeria("Terjadi gangguan jaringan saat pengiriman massal.", "error", "⚠️");
            } finally {
                isKirimMassalRunning = false;
                if (btnKirim) btnKirim.disabled = false;
            }
        }

        async function tarikDataDariSheet(isManual = false) {
            if (!DEFAULT_SCRIPT_URL) return;
            if (isManual) setStatusSyncCloud('syncing', 'Menarik Profil Cloud...');
            try {
                const response = await fetch(`${DEFAULT_SCRIPT_URL}?action=getInitialData`);
                const result = await response.json();

                if (result && result.status === 'success' && result.data) {
                    const { siswa, badges, profilDetail } = result.data;
                    const nowTime = Date.now();

                    if (Array.isArray(siswa)) {
                        siswa.forEach(s => {
                            const nis = String(s.nis);
                            if (nis === ADMIN_NIS) {
                                if (dbProfilDetail['admin']) {
                                    if (s.nama) dbProfilDetail['admin'].nama = s.nama;
                                    const normFoto = normalizePhotoUrlFromSheet(s.fotoProfil);
                                    if (normFoto) dbProfilDetail['admin'].fotoProfil = normFoto;
                                }
                                return;
                            }
                            if (!dbProfilDetail[nis]) return;
                            if (s.bintang !== undefined) dbProfilDetail[nis].bintang = parseInt(s.bintang) || 0;
                            if (s.xp !== undefined) { dbProfilDetail[nis].xp = parseInt(s.xp) || 0; dbXpSiswa[nis] = parseInt(s.xp) || 0; }
                            if (s.tabungan !== undefined) { dbProfilDetail[nis].tabungan = parseFloat(s.tabungan) || 0; dbTabunganSiswa[nis] = parseFloat(s.tabungan) || 0; }
                            const normFotoSiswa = normalizePhotoUrlFromSheet(s.fotoProfil);
                            if (normFotoSiswa) dbProfilDetail[nis].fotoProfil = normFotoSiswa;
                        });
                    }

                    if (badges && typeof badges === 'object') {
                        Object.keys(badges).forEach(nisKey => {
                            const nis = String(nisKey);
                            const lastEdit = lastBadgeLocalSaveTime[nis] || 0;
                            if (nowTime - lastEdit < 6000) return;

                            const arrStates = badges[nisKey];
                            if (Array.isArray(arrStates) && dbProfilDetail[nis]) {
                                if (!dbProfilDetail[nis].badges || dbProfilDetail[nis].badges.length < 25) {
                                    dbProfilDetail[nis].badges = Array(25).fill().map((_, i) => ({ active: false, img: "", title: BADGE_DESCS[i] }));
                                }
                                for (let idx = 0; idx < 25; idx++) {
                                    dbProfilDetail[nis].badges[idx].active = (parseInt(arrStates[idx]) === 1);
                                }
                            }
                        });
                    }

                    if (profilDetail && typeof profilDetail === 'object') {
                        Object.keys(profilDetail).forEach(nisKey => {
                            const nis = String(nisKey);
                            const d = profilDetail[nisKey];
                            if (!d) return;

                            if (nis === ADMIN_NIS && dbProfilDetail['admin']) {
                                if (d.nama) dbProfilDetail['admin'].nama = d.nama;
                                const normAdminFoto = normalizePhotoUrlFromSheet(d.fotoProfil);
                                if (normAdminFoto) dbProfilDetail['admin'].fotoProfil = normAdminFoto;
                                return;
                            }

                            if (!dbProfilDetail[nis]) return;
                            if (d.bintang !== undefined) dbProfilDetail[nis].bintang = parseInt(d.bintang) || 0;
                            if (d.xp !== undefined) { dbProfilDetail[nis].xp = parseInt(d.xp) || 0; dbXpSiswa[nis] = parseInt(d.xp) || 0; }
                            if (d.tabungan !== undefined) { dbProfilDetail[nis].tabungan = parseFloat(d.tabungan) || 0; dbTabunganSiswa[nis] = parseFloat(d.tabungan) || 0; }
                            const normDetailFoto = normalizePhotoUrlFromSheet(d.fotoProfil);
                            if (normDetailFoto) dbProfilDetail[nis].fotoProfil = normDetailFoto;
                            if (d.pamerBadgeIdx !== undefined) dbProfilDetail[nis].pamerBadgeIdx = d.pamerBadgeIdx;

                            try {
                                const parsedDescs = typeof d.badgeDescsJson === 'string' ? JSON.parse(d.badgeDescsJson) : d.badgeDescsJson;
                                if (Array.isArray(parsedDescs) && parsedDescs.length === 25) {
                                    BADGE_DESCS = parsedDescs;
                                    for (let idx = 0; idx < 25; idx++) {
                                        if (dbProfilDetail[nis].badges[idx]) dbProfilDetail[nis].badges[idx].title = parsedDescs[idx];
                                    }
                                }
                            } catch(e) {}

                            try {
                                const parsedImgs = typeof d.badgeImagesJson === 'string' ? JSON.parse(d.badgeImagesJson) : d.badgeImagesJson;
                                if (parsedImgs && typeof parsedImgs === 'object') {
                                    Object.keys(parsedImgs).forEach(bIdx => {
                                        const normBadgeImg = normalizePhotoUrlFromSheet(parsedImgs[bIdx]);
                                        if (dbProfilDetail[nis].badges[bIdx] && normBadgeImg) {
                                            dbProfilDetail[nis].badges[bIdx].img = normBadgeImg;
                                        }
                                    });
                                }
                            } catch(e) {}

                            try {
                                if (d.pelanggaranJson) dbProfilDetail[nis].pelanggaran = typeof d.pelanggaranJson === 'string' ? JSON.parse(d.pelanggaranJson) : d.pelanggaranJson;
                                if (d.nilaiJson) dbProfilDetail[nis].nilai = typeof d.nilaiJson === 'string' ? JSON.parse(d.nilaiJson) : d.nilaiJson;
                            } catch(e) {}
                        });
                    }

                    simpanSemuaData();
                    if (currentNis) gantiSiswaProfil(currentNis);
                    renderFormPostUser();
                    perbaruiBannerBerandaFeed();
                    renderFeedsStatusUI();
                    setStatusSyncCloud('synced', 'Tersinkron Cloud');

                    if (isManual) {
                        playBeepSound(1050, 'sine', 0.15);
                        tampilToastCeria("Data profil, foto, nilai & badge terbaru berhasil ditarik dari Google Sheet! 📥✨", "success", "📥");
                    }
                }
            } catch (e) {
                setStatusSyncCloud('offline', 'Mode Cache Lokal');
                if (isManual) tampilToastCeria("Gagal menarik data dari Google Sheet. Periksa koneksi internet.", "error", "⚠️");
            }
        }

