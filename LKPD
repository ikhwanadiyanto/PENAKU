                const optB = (document.getElementById('inputQuizOptB')?.value || "").trim();
                const optC = (document.getElementById('inputQuizOptC')?.value || "").trim();
                const optD = (document.getElementById('inputQuizOptD')?.value || "").trim();
                const ansKey = (document.getElementById('selectQuizAnswerKey')?.value || "A").toUpperCase();

                if (!qText || !optA || !optB || !optC || !optD) {
                    tampilToastCeria("Lengkapi Pertanyaan Kuis beserta seluruh Pilihan A, B, C, dan D!", "warning", "🎯");
                    return;
                }
                quizPayload = {
                    question: qText,
                    options: { A: optA, B: optB, C: optC, D: optD },
                    answerKey: ansKey,
                    responses: {}
                };
            }

            if (!teks && !tempFotoStatusBase64 && !ytUrl && !quizPayload) {
                tampilToastCeria("Tuliskan sesuatu, lampirkan foto, video YouTube, atau buat Kuis ABCD terlebih dahulu!", "warning", "🎃");
