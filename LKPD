        async function eksekusiMigrasiSiswaKeAlumni() {
            if (!isAdminMode) return;
            const checkedBoxes = Array.from(document.querySelectorAll('.chk-siswa-migrasi-alumni:checked'));
            if (checkedBoxes.length === 0) {
                tampilToastCeria("Pilih minimal satu siswa aktif yang akan dimigrasi menjadi alumni!", "warning", "🎓");
                return;
            }

            const angkatan = (document.getElementById('inputMigrasiAngkatan')?.value || "2026").trim() || "2026";
            const passMode = document.getElementById('selectMigrasiPasswordMode')?.value || "nis";
            const salinRiwayat = document.getElementById('checkMigrasiPindahRiwayat')?.checked !== false;

            const setuju = await tampilKonfirmasiCeria(
                `Migrasi ${checkedBoxes.length} akun siswa aktif menjadi Alumni Angkatan ${angkatan}? Akun alumni otomatis aktif (ACC) dan dapat langsung login melalui Portal Alumni.`,
                "Konfirmasi Migrasi Alumni 🎓",
                "🎓"
            );
            if (!setuju) return;

            const btnEksekusi = document.getElementById('btnEksekusiMigrasiAlumni');
            const progressBox = document.getElementById('boxProgressMigrasiAlumni');
            const lblStatus = document.getElementById('lblStatusMigrasiAlumni');
            const lblPersen = document.getElementById('lblPersenMigrasiAlumni');
            const barProgress = document.getElementById('barProgressMigrasiAlumni');

            if (btnEksekusi) btnEksekusi.disabled = true;
            if (progressBox) progressBox.classList.remove('hidden');

            const nowStr = new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
            let jumlahSukses = 0;

            try {
                for (let i = 0; i < checkedBoxes.length; i++) {
                    const nisSiswa = String(checkedBoxes[i].value);
                    const siswaRow = listMasterSiswa.find(s => String(s[0]) === nisSiswa);
                    if (!siswaRow) continue;

                    const namaSiswa = siswaRow[1];
                    const baseHandle = buatHandleTwitter(namaSiswa).replace('@', '') || `siswa${nisSiswa}`;
                    let usernameAlumni = `${baseHandle}${angkatan.slice(-2)}`;

                    const existingByNis = listAlumniTerdaftar.find(a => a.sourceSiswaNis === nisSiswa || a.nama.trim().toLowerCase() === namaSiswa.trim().toLowerCase());
                    if (existingByNis) {
                        usernameAlumni = existingByNis.username;
                    } else if (listAlumniTerdaftar.some(a => a.username.toLowerCase() === usernameAlumni.toLowerCase())) {
                        usernameAlumni = `${baseHandle}_${nisSiswa}`;
                    }

                    const alumniId = existingByNis ? existingByNis.id : `alumni_${usernameAlumni}`;
                    const passwordAlumni = (passMode === "2026") ? angkatan : nisSiswa;
                    const pSiswa = dbProfilDetail[nisSiswa] || {};

                    const alumniRecord = {
                        id: alumniId,
                        username: usernameAlumni,
                        nama: namaSiswa,
                        angkatan: angkatan,
                        password: passwordAlumni,
                        fotoProfil: salinRiwayat ? (pSiswa.fotoProfil || "") : "",
                        status: "approved",
                        sourceSiswaNis: nisSiswa,
                        createdAt: existingByNis?.createdAt || nowStr,
                        approvedAt: nowStr,
                        updatedAt: Date.now()
                    };

                    const idxExist = listAlumniTerdaftar.findIndex(a => a.id === alumniId);
                    if (idxExist >= 0) listAlumniTerdaftar[idxExist] = alumniRecord;
                    else listAlumniTerdaftar.push(alumniRecord);

                    dbProfilDetail[alumniId] = {
                        ...(dbProfilDetail[alumniId] || {}),
                        nama: namaSiswa,
                        angkatan: angkatan,
                        fotoProfil: salinRiwayat ? (pSiswa.fotoProfil || "") : "",
                        bintang: salinRiwayat ? (parseInt(pSiswa.bintang) || 5) : 5,
                        xp: salinRiwayat ? (parseInt(pSiswa.xp) || 100) : 100,
                        tabungan: salinRiwayat ? (parseFloat(pSiswa.tabungan) || 0) : 0,
                        badges: salinRiwayat && Array.isArray(pSiswa.badges)
                            ? JSON.parse(JSON.stringify(pSiswa.badges))
                            : Array(25).fill().map((_, idx) => ({ active: idx === 0, img: "", title: BADGE_DESCS[idx] })),
                        pamerBadgeIdx: pSiswa.pamerBadgeIdx || 0,
                        pelanggaran: [],
                        nilai: salinRiwayat && pSiswa.nilai ? JSON.parse(JSON.stringify(pSiswa.nilai)) : {}
                    };

                    if (salinRiwayat && Array.isArray(dbChatAdmin[nisSiswa]) && dbChatAdmin[nisSiswa].length > 0) {
                        dbChatAdmin[alumniId] = dbChatAdmin[nisSiswa].map(m => ({ ...m, siswaNis: alumniId }));
                    }

                    const persen = Math.round(((i + 1) / checkedBoxes.length) * 100);
                    if (lblStatus) lblStatus.innerHTML = `<i class="fa-solid fa-spinner fa-spin text-orange-500 mr-1"></i> Migrasi (${i + 1}/${checkedBoxes.length}): ${namaSiswa} (@${usernameAlumni})`;
                    if (lblPersen) lblPersen.innerText = `${persen}%`;
                    if (barProgress) barProgress.style.width = `${persen}%`;

                    await kirimAlumniRegistryKeSheet(alumniRecord, "migrate_student");
                    await kirimDataProfilLengkapKeSheet(alumniId);
                    jumlahSukses++;
                    await new Promise(r => setTimeout(r, 110));
                }

                await simpanDaftarAlumniSemuaStorage();
                simpanSemuaData();
                simpanChatAdminKeIndexedDB(dbChatAdmin);

                populasiDropdownSiswa();
                renderGridDaftarAlumni();
                renderGridDaftarSiswa();
                perbaruiBadgeAntrianAlumniUI();

                playBeepSound(1200, 'sine', 0.25);
                tampilToastCeria(
                    `Berhasil memigrasi ${jumlahSukses} siswa aktif menjadi Alumni Angkatan ${angkatan}! 🎓✨`,
                    "success",
                    "🎓"
                );
                setTimeout(() => { tutupModalMigrasiAlumni(); }, 900);
            } catch (err) {
                tampilToastCeria("Terjadi kendala saat migrasi sebagian akun. Data lokal tetap tersimpan.", "warning", "⚠️");
            } finally {
                if (btnEksekusi) btnEksekusi.disabled = false;
            }
        }

