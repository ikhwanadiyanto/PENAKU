        function sisipkanMentionKeInput(namaTarget) {
            if (!activeMentionInputId) return;
            const el = document.getElementById(activeMentionInputId);
            const popover = document.getElementById('popoverMentionPicker');
            if (!el) return;

            const pos = el.selectionStart || el.value.length;
            const before = el.value.slice(0, pos);
            const after = el.value.slice(pos);
            const replacedBefore = before.replace(/@([a-zA-Z0-9_\s]{0,20})$/, '');
            const prefixSpace = (replacedBefore.length > 0 && !/\s$/.test(replacedBefore)) ? ' ' : '';
            const mentionStr = `${prefixSpace}@${namaTarget} `;

            el.value = replacedBefore + mentionStr + after;
            const newCursorPos = (replacedBefore + mentionStr).length;
            el.focus();
            el.setSelectionRange(newCursorPos, newCursorPos);

            if (popover) popover.classList.add('hidden');
            activeMentionInputId = null;
            playBeepSound(980, 'sine', 0.08);
        }

