                        if (parsed[k] && parsed[k].fotoProfil) parsed[k].fotoProfil = normalizePhotoUrlFromSheet(parsed[k].fotoProfil);
                    });
                    dbProfilDetail = parsed;
                } catch(e) {}
            }
            if (savedBadges) {
                try {
                    const parsedB = JSON.parse(savedBadges);
                    if (Array.isArray(parsedB) && parsedB.length === 25) BADGE_DESCS = parsedB;
                } catch(e) {}
            }
            if (savedTabungan) { try { dbTabunganSiswa = JSON.parse(savedTabungan); } catch(e) {} }
            if (savedXp) { try { dbXpSiswa = JSON.parse(savedXp); } catch(e) {} }

            if (!dbProfilDetail['admin']) {
                dbProfilDetail['admin'] = {
                    nama: DEFAULT_ADMIN_NAME, fotoProfil: "", bintang: 999, xp: 9999, tabungan: 0,
                    badges: Array(25).fill().map((_, i) => ({ active: true, img: "", title: BADGE_DESCS[i] })),
                    pelanggaran: [], nilai: {}
                };
            }

            listMasterSiswa.forEach(s => {
                const nis = String(s[0]);
                if (!dbProfilDetail[nis]) {
                    dbProfilDetail[nis] = {
                        fotoProfil: "", bintang: 0, xp: dbXpSiswa[nis] || 0, tabungan: dbTabunganSiswa[nis] || 0,
                        badges: Array(25).fill().map((_, i) => ({ active: false, img: "", title: BADGE_DESCS[i] })),
                        pamerBadgeIdx: null,
                        pelanggaran: [],
                        nilai: { pancasila: 0, indonesia: 0, matematika: 0, ipas: 0, inggris: 0, jawa: 0, senirupa: 0, senimusik: 0, senitari: 0, seniteater: 0, agama: 0, pjok: 0, sakit: 0, izin: 0, alpa: 0, ekskul1: "", predikat1: "", ekskul2: "", predikat2: "" }
                    };
                }
            });
        }

