            }

            const info = getUserDisplayInfo(loggedInNis);
            const now = new Date();
            const waktuStr = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

            const newPost = {
                id: "post_" + Date.now(),
